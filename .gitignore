# moire's own state lives inside .git/moire/ and is never committed by
# construction. These are the usual local strays.

__pycache__/
*.py[cod]
.DS_Store
*.swp
*~

# client-local agent config: contains absolute, clone-specific paths
.claude/settings.local.json
.cursor/hooks.json
.codex/hooks.json

# Working research, design history and review material — kept locally, not
# published. The one exception is the Phase 1 results directory, which the
# pre-registration promises to publish: "/research/" alone would have
# swallowed it silently, and a negation cannot re-include anything under an
# excluded DIRECTORY, so the contents are excluded and that one path is
# restored.
/research/*
!/research/phase1-results/

# npm
node_modules/
*.tgz

# Corpus harness working data: the cached AIDev tables, the bare clones it
# makes of other people's repositories, and the JSONL it accumulates. Large,
# regenerable from the scripts, and not ours to redistribute. The RESULTS of
# a run are published deliberately, under research/phase1-results/, not by
# accidentally committing this directory.
/tools/replay-corpus/cache/
