#!/usr/bin/env python3
"""moire - observed-diff conflict detection between concurrent git worktrees.

Answers one question: right now, would my worktree and each peer worktree conflict
if both landed? Uses `git merge-tree --write-tree` as an exact oracle.

Load-bearing facts:
  - git >= 2.38 REQUIRED. Legacy 3-arg merge-tree gives false negatives on
    rename/rename, modify/delete and binary-both-sides. We refuse rather than degrade.
  - Verdict comes from the EXIT CODE, never from grepping output for conflict
    markers (file content can contain them).
  - Warn-only. There is no block mode and no flag to add one.
  - Observation never mutates the observed worktree: we copy its index and work
    through GIT_INDEX_FILE, so even a held index.lock does not stop us.

Note: snapshot trees/commits are written into the repo's own object store. They are
refless, deterministic (fixed committer date, so an unchanged worktree re-snapshots
to the same OIDs and writes nothing), and reclaimed by git's own housekeeping
(`git maintenance` / `git gc`, which normal commit and fetch activity already
triggers). moire never deletes an object. No alternates scheme by design (phase 0
simplicity): a quarantined object store needs a per-worktree GIT_DIR to resolve HEAD
correctly, duplicates every object the agent goes on to commit, and makes the
`merged_tree` OIDs moire prints unreadable with a plain `git archive`.

Python 3.8 compatible, stdlib only.
"""

import ast
import difflib
import filecmp
import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import uuid
from datetime import datetime, timezone

MIN_GIT = (2, 38)
SNAPSHOT_ENV = {
    "GIT_AUTHOR_NAME": "moire", "GIT_AUTHOR_EMAIL": "moire@localhost",
    "GIT_COMMITTER_NAME": "moire", "GIT_COMMITTER_EMAIL": "moire@localhost",
    # Fixed FUTURE date (2100-01-01T00:00:00Z in git's internal "@<epoch> <tz>"
    # form). Pinning identity but not dates made every snapshot commit of an
    # UNCHANGED tree a fresh OID once per wall-clock second, so an idle repo
    # under a per-write hook grew .git/objects at ~1 object/second forever.
    # With the dates pinned the snapshot commit is a pure function of (tree,
    # parent): re-observing an unchanged worktree writes nothing. Measured on a
    # 200-file lab repo with one peer worktree and MOIRE_CACHE_TTL=0: 60 idle
    # checks used to add one object per second of ELAPSED time, not per check
    # (+17 over 15.6s, +22 over 21.5s, +10 over 10.1s across runs); they now add
    # 1 on the first run and exactly 0 on every run after. Latency is unchanged
    # (median 242.5ms before / 244.2ms after, 100 interleaved checks per arm) -
    # this buys object count, not speed.
    #
    # MUST be a future date, never epoch 0. git's merge-base/merge-tree walk a
    # commit-date priority queue and stop on a date cutoff; a tip older than its
    # own ancestors defeats that. Measured on a 100k-commit history: merge-base
    # 503ms / merge-tree 572ms at "@0" versus 16ms / 16ms here and 16ms / 17ms
    # for the real branch tips with no snapshot commit at all.
    #
    # Nothing reads these dates. compute_arbiter's rules are tree-OID equality,
    # `diff --name-only` and `rev-list --count` - content and topology, never
    # time - and no snapshot commit is ever named by a ref or written to a record.
    "GIT_AUTHOR_DATE": "@4102444800 +0000", "GIT_COMMITTER_DATE": "@4102444800 +0000",
}
HOOK_MARKER = "# >>> moire hook >>>"
HOOKS = ("post-commit", "post-merge")
DEFAULT_CACHE_TTL = 2.0


# ---------------------------------------------------------------- git plumbing

def _run(args, cwd=None, env=None, check=False):
    e = dict(os.environ)
    if env:
        e.update(env)
    p = subprocess.run(args, cwd=cwd, env=e, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE)
    out = p.stdout.decode("utf-8", "replace")
    err = p.stderr.decode("utf-8", "replace")
    if check and p.returncode != 0:
        raise RuntimeError("%s failed (%d): %s" % (" ".join(args[:3]), p.returncode, err.strip()))
    return p.returncode, out, err


def _parse_version(s):
    parts = s.split()
    for tok in parts:
        bits = tok.split(".")
        if len(bits) >= 2 and bits[0].isdigit() and bits[1].isdigit():
            return (int(bits[0]), int(bits[1]))
    return (0, 0)


def find_git():
    """Return (path, (major,minor)) for a git >= MIN_GIT, or (path, ver) of the best found.

    MOIRE_GIT is EXCLUSIVE: if the caller names a git explicitly we use exactly that one,
    even when it is too old. Falling back to a newer git on PATH would silently defeat
    `MOIRE_GIT=/usr/bin/git moire check`, which must refuse.
    """
    forced = os.environ.get("MOIRE_GIT")
    if forced:
        if not os.path.exists(forced):
            return None, (0, 0)
        rc, out, _ = _run([forced, "--version"])
        return (forced, _parse_version(out)) if rc == 0 else (None, (0, 0))
    cands = []
    w = shutil.which("git")
    if w:
        cands.append(w)
    cands.append("/opt/homebrew/bin/git")
    cands.append("/usr/bin/git")
    best = (None, (0, 0))
    for c in cands:
        if not c or not os.path.exists(c):
            continue
        rc, out, _ = _run([c, "--version"])
        if rc != 0:
            continue
        v = _parse_version(out)
        if v >= MIN_GIT:
            return c, v
        if v > best[1]:
            best = (c, v)
    return best


class Git(object):
    def __init__(self, path, version):
        self.path = path
        self.version = version

    def __call__(self, args, cwd=None, env=None, check=False):
        return _run([self.path] + args, cwd=cwd, env=env, check=check)

    def out(self, args, cwd=None, env=None):
        rc, o, e = self(args, cwd=cwd, env=env)
        return o.strip() if rc == 0 else None

    @property
    def version_str(self):
        return "%d.%d" % self.version


def common_dir(git, cwd):
    """Absolute realpath of $GIT_COMMON_DIR.

    `git rev-parse --git-common-dir` yields a path relative to the CWD in the main
    worktree and an absolute one from a linked worktree; --path-format=absolute does
    not exist before git 2.31. Normalise both to the same absolute realpath.
    """
    p = git.out(["rev-parse", "--git-common-dir"], cwd=cwd)
    if p is None:
        return None
    if not os.path.isabs(p):
        p = os.path.join(cwd, p)
    return os.path.realpath(p)


def state_dir(cd):
    return os.path.join(cd, "moire")


def log_dir(cd):
    return os.path.join(state_dir(cd), "log")


def cache_dir(cd):
    return os.path.join(state_dir(cd), "cache")


def installed_bin(cd):
    return os.path.join(state_dir(cd), "bin", "moire")


def list_worktrees(git, cwd):
    """-> [{'worktree','head','branch'}] from `git worktree list --porcelain`."""
    rc, out, _ = git(["worktree", "list", "--porcelain"], cwd=cwd)
    if rc != 0:
        return []
    res, cur = [], {}
    for line in out.split("\n"):
        line = line.rstrip()
        if not line:
            if cur.get("worktree"):
                res.append(cur)
            cur = {}
            continue
        if line.startswith("worktree "):
            cur = {"worktree": os.path.realpath(line[9:]), "head": None, "branch": None}
        elif line.startswith("HEAD "):
            cur["head"] = line[5:]
        elif line.startswith("branch "):
            b = line[7:]
            cur["branch"] = b[11:] if b.startswith("refs/heads/") else b
        elif line == "detached":
            cur["branch"] = None
    if cur.get("worktree"):
        res.append(cur)
    return res


def _index_path(git, wt):
    """-> absolute path to `wt`'s real index file (may not exist yet)."""
    idx = git.out(["rev-parse", "--git-path", "index"], cwd=wt)
    if idx and not os.path.isabs(idx):
        idx = os.path.join(wt, idx)
    return idx


def _index_fingerprint(git, wt):
    """-> (mtime, size) of `wt`'s real index file, or (None, None) if it has none yet.

    Read-only `os.stat` on the real index - never opened for writing, so this
    cannot be the mutation snapshot()'s copy-the-index dance exists to avoid.
    """
    idx = _index_path(git, wt)
    if idx and os.path.exists(idx):
        st = os.stat(idx)
        return st.st_mtime, st.st_size
    return None, None


def snapshot(git, wt):
    """Snapshot a worktree (HEAD + staged + unstaged + untracked) -> commit oid.

    Works through a COPY of the worktree's index so the observed worktree is never
    mutated and a held index.lock in it does not block us.
    """
    idx = _index_path(git, wt)
    tmp = tempfile.NamedTemporaryFile(prefix="moire-index-", delete=False)
    tmp.close()
    tmpidx = tmp.name
    try:
        if idx and os.path.exists(idx):
            shutil.copyfile(idx, tmpidx)
        else:
            os.unlink(tmpidx)
        env = {"GIT_INDEX_FILE": tmpidx}
        env.update(SNAPSHOT_ENV)
        # `add -A` is what makes this a snapshot of the WORKING TREE rather
        # than of HEAD, so its failure is not cosmetic: the copied index would
        # simply keep the committed state, write-tree would return a stale but
        # perfectly valid tree, commit-tree would succeed, and the caller would
        # get a confident verdict computed against a tree missing everything
        # the agent just wrote. That is the one error the cache note below
        # calls out as silently producing a wrong answer, so it is raised here
        # and becomes verdict "error" - still warn-only, still exit 0, but
        # never a wrong "clean".
        git(["add", "-A"], cwd=wt, env=env, check=True)
        tree = git.out(["write-tree"], cwd=wt, env=env)
        if not tree:
            raise RuntimeError("write-tree produced no output for %s" % wt)
        head = git.out(["rev-parse", "HEAD"], cwd=wt)
        args = ["commit-tree", tree]
        if head:
            args += ["-p", head]
        args += ["-m", "moire snapshot"]
        commit = git.out(args, cwd=wt, env=env)
        if not commit:
            raise RuntimeError("commit-tree failed for %s" % wt)
        return tree, commit
    finally:
        if os.path.exists(tmpidx):
            os.unlink(tmpidx)


# --------------------------------------------------------------- snapshot cache
#
# A worktree snapshot (copy index -> add -A -> write-tree -> commit-tree) is
# ~43ms, the dominant cost of `moire check` (~43 + 55N ms for N peers). Self MUST
# be recomputed every time -- the agent invoking us just wrote, so a stale
# self-snapshot is the one error that silently produces a wrong verdict. A
# PEER's snapshot may be reused across processes/invocations because nothing
# about it changed since it was last observed: same HEAD, same index file
# (mtime+size), and not older than MOIRE_CACHE_TTL. Working-tree edits (a plain
# `Write` with no `git add`) touch neither HEAD nor the index, so a peer's
# uncommitted edits can be up to TTL stale in a cache hit -- acceptable for an
# advisory, warn-only signal, not acceptable for the self side, which is why
# self never consults this cache at all.

def cache_ttl():
    v = os.environ.get("MOIRE_CACHE_TTL")
    if v:
        try:
            return float(v)
        except ValueError:
            pass
    return DEFAULT_CACHE_TTL


def _cache_file(cd, worktree):
    h = hashlib.sha1(worktree.encode("utf-8")).hexdigest()
    return os.path.join(cache_dir(cd), h + ".json")


def read_snapshot_cache(cd, worktree):
    """-> the cached record dict for `worktree`, or None (missing/unparsable)."""
    try:
        with open(_cache_file(cd, worktree)) as f:
            return json.load(f)
    except Exception:
        return None


def write_snapshot_cache(cd, worktree, tree, commit, head, idx_mtime, idx_size):
    """Temp-file + os.rename, same pattern as the log shards: a reader never
    observes a partially-written cache file."""
    try:
        os.makedirs(cache_dir(cd))
    except OSError:
        pass
    rec = {"worktree": worktree, "tree": tree, "commit": commit, "head": head,
           "index_mtime": idx_mtime, "index_size": idx_size, "cached_at": time.time()}
    path = _cache_file(cd, worktree)
    tmp = "%s.tmp-%d-%s" % (path, os.getpid(), uuid.uuid4().hex[:6])
    try:
        with open(tmp, "w") as f:
            json.dump(rec, f)
        os.rename(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass


def snapshot_peer_cached(git, wt, cd, head):
    """Snapshot a PEER worktree, reusing a cached (tree, commit) when safe.

    -> (tree, commit, was_cached). Never call this for self - see the module
    note above. A hit requires the cached worktree, HEAD, and index
    mtime+size to all match the current observed state, and `cached_at` to be
    within MOIRE_CACHE_TTL. Any mismatch, missing cache, or parse failure falls
    through to a real snapshot() call, whose result is then written back so
    the NEXT observer (which may be a different moire process entirely, e.g.
    another agent's own `moire check` treating this worktree as a peer) gets a
    hit too.
    """
    cached = read_snapshot_cache(cd, wt) if cd else None
    if cached:
        idx_mtime, idx_size = _index_fingerprint(git, wt)
        if (cached.get("worktree") == wt and cached.get("tree") and cached.get("commit")
                and cached.get("head") == head
                and cached.get("index_mtime") == idx_mtime and cached.get("index_size") == idx_size
                and (time.time() - float(cached.get("cached_at", 0))) <= cache_ttl()):
            return cached["tree"], cached["commit"], True
    tree, commit = snapshot_peer_fresh(git, wt, cd, head)
    return tree, commit, False


def snapshot_peer_fresh(git, wt, cd, head):
    """Snapshot a PEER worktree unconditionally and republish the cache entry.

    -> (tree, commit). This is the recompute-on-finding path: a CONFLICT or a
    BROKEN computed against a cached peer snapshot is re-derived here against
    the peer's state right now, before it is emitted. The cache's staleness
    window (<= MOIRE_CACHE_TTL) is harmless for a clean verdict - it
    self-corrects on the next check and nobody acts on "clean" - but a stale
    FINDING is the one mode where moire is confidently wrong in the direction
    of a warning: the peer reverts its edit, and self keeps printing a
    collision that no longer exists for as long as the TTL lasts. The cost of
    the extra snapshot lands only on the rare finding path.

    The index fingerprint is read BEFORE the snapshot, exactly as
    snapshot_peer_cached does: a fingerprint taken afterwards could match an
    index the snapshot did not actually see, turning a later cache hit into a
    silently stale one.
    """
    idx_mtime, idx_size = _index_fingerprint(git, wt)
    tree, commit = snapshot(git, wt)
    if cd:
        write_snapshot_cache(cd, wt, tree, commit, head, idx_mtime, idx_size)
    return tree, commit


def oracle(git, cwd, commit_a, commit_b):
    """-> ('clean'|'conflict', [paths]).  Verdict from EXIT CODE, never marker grep.

    Run with cwd = the acting worktree: merge-tree resolves .gitattributes (merge
    drivers) from the checkout it runs in.
    """
    rc, out, err = git(["merge-tree", "--write-tree", "--name-only", commit_a, commit_b], cwd=cwd)
    if rc == 0:
        return "clean", []
    if rc == 1:
        lines = out.split("\n")
        paths = []
        for ln in lines[1:]:          # line 0 is the merged tree OID
            if ln.strip() == "":
                break                 # blank line ends the conflicted-file section
            paths.append(ln.strip())
        return "conflict", paths
    raise RuntimeError("merge-tree failed (%d): %s" % (rc, (err or out).strip()))


def oracle_tree(git, cwd, commit_a, commit_b):
    """-> ('clean'|'conflict', [paths], merged_tree_oid).  Sibling of oracle().

    `git merge-tree --write-tree --name-only` prints the merged tree's OID as
    stdout line 0 on BOTH a clean merge (exit 0) and a conflicted one (exit 1) --
    on conflict the tree is written anyway with conflict markers baked in.
    `verify` reads that conflicted tree too, when the builtin checker runs
    under a textual conflict to catch breakage on files disjoint from it (the
    marker-laden files are unparsable, so the checker withholds judgement on
    them). Verdict still comes from the EXIT CODE only, exactly like oracle();
    this function only adds the OID oracle() drops.
    """
    rc, out, err = git(["merge-tree", "--write-tree", "--name-only", commit_a, commit_b], cwd=cwd)
    lines = out.split("\n")
    tree = lines[0].strip() if lines and lines[0].strip() else None
    if rc == 0:
        return "clean", [], tree
    if rc == 1:
        paths = []
        for ln in lines[1:]:          # line 0 is the merged tree OID
            if ln.strip() == "":
                break                 # blank line ends the conflicted-file section
            paths.append(ln.strip())
        return "conflict", paths, tree
    raise RuntimeError("merge-tree failed (%d): %s" % (rc, (err or out).strip()))


def materialize_tree(git, cwd, tree_oid, dest):
    """Materialise a tree object into an empty directory: `git archive | tar -x`.

    No worktree is created, no index or HEAD is touched anywhere; `cwd` merely
    needs to be some path inside the repo so `git archive` can find the object
    store (it does not read the checkout at `cwd`). `dest` must already exist.
    """
    p1 = subprocess.Popen([git.path, "-C", cwd, "archive", tree_oid],
                          stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    p2 = subprocess.Popen(["tar", "-x", "-C", dest],
                          stdin=p1.stdout, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    p1.stdout.close()                 # let p1 see SIGPIPE if p2 exits early
    _out2, err2 = p2.communicate()
    _out1, err1 = p1.communicate()
    if p1.returncode != 0:
        raise RuntimeError("git archive %s failed: %s" %
                           (tree_oid, err1.decode("utf-8", "replace").strip()))
    if p2.returncode != 0:
        raise RuntimeError("tar extract of %s failed: %s" %
                           (tree_oid, err2.decode("utf-8", "replace").strip()))


def _valid_link_name(name):
    """A link name must be a single path component: it is joined onto both a
    real worktree and a materialised temporary tree, so anything that can
    traverse out of either ('/', '\\', '.', '..') is refused rather than
    normalised. One predicate for both sources of names - the `--link` flag
    and `git config moire.link` - so the two can never disagree.
    """
    return bool(name) and "/" not in name and "\\" not in name and name not in (".", "..")


def link_directories(dest, source_worktree, names):
    """Symlink user-named directories from a real worktree into a materialised
    tree. `git archive` emits tracked files only, so a gitignored dependency
    directory (node_modules, .venv, vendor, ...) is absent from every
    materialised tree and a checker that needs one drowns in unresolved-module
    noise. The user names the directory; moire knows nothing about any package
    manager. For each name: link only if `<source_worktree>/<name>` is an
    existing directory AND the materialised tree has nothing at that name
    already (a tracked entry is left alone); otherwise skip silently. The
    MERGED tree borrows SELF's worktree as its source - a deliberate
    approximation: the merged state was never checked out anywhere, so it has
    no dependency directory of its own, and self's is the closest stand-in.
    The symlink is LIVE, not read-only: a checker that writes into the linked
    directory (tsc --incremental's .tsbuildinfo, eslint --cache, anything
    using node_modules/.cache) writes straight through into the real worktree
    it points at - nothing here enforces read-only, because a portable
    stdlib-only enforcement does not exist. Only link a directory whose
    contamination by the checker is acceptable. -> list of names actually
    linked.
    """
    linked = []
    for name in names:
        src = os.path.join(source_worktree, name)
        tgt = os.path.join(dest, name)
        if not os.path.isdir(src):
            continue
        if os.path.lexists(tgt):
            continue                  # tracked entry materialised there: leave it alone
        os.symlink(os.path.abspath(src), tgt)
        linked.append(name)
    return linked


def link_directories_union(dest, self_worktree, peer_worktree, names):
    """Link a named directory into the MERGED tree from BOTH worktrees at once.

    The merged state was never checked out anywhere, so it has no dependency
    directory of its own and has to borrow one. Borrowing self's whole
    directory - what link_directories does - is wrong in one ordinary case:
    the peer added something to its own copy (installed a dependency) and its
    committed code refers to it. The merged tree then contains the peer's
    code and self's directory, the checker cannot resolve the entry, and the
    difference is reported as breakage the pair created. It is not: it is an
    artifact of which worktree the borrowed directory came from. That was
    reproduced, and this is the fix.

    Per name: if only one worktree has the directory, symlink that one whole.
    If both have it and every top-level entry of the peer's is also in self's,
    symlink self's whole - the union would be byte-identical and a directory
    of symlinks is strictly more to go wrong. Only when the peer has entries
    self does not (the divergence that actually matters) is a real union
    built: a directory of per-entry symlinks, self's copy winning every
    both-present entry, because self's tree is the one the merged tree
    otherwise resembles.

    -> {name: {"mode": "self"|"peer"|"union", "from_peer": [entry, ...],
    "peer_only_count": n}}. Provenance, not a claim: moire knows nothing
    about what any of these entries are, and never says "package".

    Any error building a union degrades to the whole-self symlink and records
    "union_error" - the same posture as everything else here, where a link
    that cannot be made is a checker that sees less, never a failed verdict.

    The union directory itself lives in the throwaway merged tree and is
    removed with it; `shutil.rmtree` unlinks symlinks rather than following
    them, so neither worktree's real directory is touched. The links are LIVE
    in the same sense link_directories describes - a checker that writes into
    one writes through into a real worktree - and this adds no exposure the
    peer did not already have, since the peer tree links from the peer's own
    worktree already. Only link a directory whose contamination by the
    checker is acceptable.
    """
    provenance = {}
    for name in names:
        if not _valid_link_name(name):
            continue
        tgt = os.path.join(dest, name)
        if os.path.lexists(tgt):
            continue                  # tracked entry materialised there: leave it alone
        s = os.path.join(self_worktree, name)
        p = os.path.join(peer_worktree, name)
        s_dir, p_dir = os.path.isdir(s), os.path.isdir(p)
        if not s_dir and not p_dir:
            continue
        if not p_dir:
            os.symlink(os.path.abspath(s), tgt)
            provenance[name] = {"mode": "self", "from_peer": [], "peer_only_count": 0}
            continue
        if not s_dir:
            os.symlink(os.path.abspath(p), tgt)
            provenance[name] = {"mode": "peer", "from_peer": [], "peer_only_count": 0}
            continue
        try:
            s_entries = sorted(os.listdir(s))
            peer_only = sorted(set(os.listdir(p)) - set(s_entries))
        except OSError as ex:
            os.symlink(os.path.abspath(s), tgt)
            provenance[name] = {"mode": "self", "from_peer": [], "peer_only_count": 0,
                                "union_error": str(ex)}
            continue
        if not peer_only:
            os.symlink(os.path.abspath(s), tgt)
            provenance[name] = {"mode": "self", "from_peer": [], "peer_only_count": 0}
            continue
        try:
            os.mkdir(tgt)
            for e in s_entries:
                os.symlink(os.path.join(os.path.abspath(s), e), os.path.join(tgt, e))
            for e in peer_only:
                os.symlink(os.path.join(os.path.abspath(p), e), os.path.join(tgt, e))
        except OSError as ex:
            shutil.rmtree(tgt, ignore_errors=True)
            provenance[name] = {"mode": "self", "from_peer": [], "peer_only_count": 0,
                                "union_error": str(ex)}
            if not os.path.lexists(tgt):
                os.symlink(os.path.abspath(s), tgt)
            continue
        provenance[name] = {"mode": "union", "from_peer": peer_only[:20],
                            "peer_only_count": len(peer_only)}
    return provenance


# ------------------------------------------------------ builtin semantic checker
#
# Cross-module import resolver over stdlib `ast`. Every import in the tree is
# recorded as a finding unless it demonstrably resolves INSIDE that tree: for
# `from M import N` and `import M.N`, that M is a module in the tree and N is
# defined, imported or re-exported by it; for `import M`, that M is a module in
# the tree at all.
#
# An import of a module that is not in the tree - `os`, `numpy`, and equally a
# module some other agent just deleted - is therefore a finding too, and this
# is deliberate. Withholding it at DETECTION time is what made the mechanism
# blind to its own headline failure: one agent deletes or moves pkg/util.py
# while the other adds a file importing it, the merged tree cannot import, and
# `verify` said "semantic ok". The tool detected a NAME vanishing from a
# surviving module and missed the MODULE vanishing - the README's own metaphor,
# one builder moving the door while the other builds a path to where it was.
#
# Ambient breakage is removed by SUBTRACTION instead, which is where it always
# belonged: `broken(merged) - broken(self) - broken(peer)`. `import os` is
# unresolvable in all three trees, so it cancels; a module that resolved in
# both parents and not in the merge does not. The cost is that per-tree finding
# counts are now dominated by third-party and stdlib imports - one to two
# orders of magnitude higher - and those counts appear in `verify`'s clean line
# and in the record. They are an intermediate quantity; only the difference is
# a judgement.
#
# What is still withheld is what `ast` genuinely cannot answer: an unparsable
# file (conflict markers, a syntax error, an unreadable encoding), a
# `from X import *` in the module being resolved against, whose exports cannot
# be enumerated, and a namespace package - importable at runtime with no
# `__init__.py` to read and members that may be extension modules `ast` never
# sees. Each of those is a question with no answer available here, which is a
# different thing from an answer we decline to record.

_BK_SKIP_DIRS = (".git", "node_modules", ".tox", "build", "dist")


def _module_map(root):
    """-> ({dotted module name -> file path}, {dotted package prefix}) for every
    .py file under root.

    Modules are indexed under every dotted suffix (src/pkg/mod.py ->
    "src.pkg.mod", "pkg.mod", "mod") so a `from pkg import mod` resolves
    regardless of where in the tree "pkg" sits relative to any assumed source
    root.

    The second set holds every dotted PREFIX of those names - the directories
    on the way to a module, whether or not they carry an `__init__.py`. A
    namespace package imports fine at runtime while owning no .py file of its
    own, so without this set every `import a.b` under a PEP-420 layout would
    read as an absent module.
    """
    m = {}
    pkgs = set()
    for dp, dn, fn in os.walk(root):
        dn[:] = [d for d in dn if d not in _BK_SKIP_DIRS]
        for f in fn:
            if not f.endswith(".py"):
                continue
            full = os.path.join(dp, f)
            rel = os.path.relpath(full, root)
            parts = rel[:-3].split(os.sep)
            if parts[-1] == "__init__":
                parts = parts[:-1]
            if not parts:
                continue
            for i in range(len(parts)):
                suffix = parts[i:]
                m.setdefault(".".join(suffix), full)
                for j in range(1, len(suffix)):
                    pkgs.add(".".join(suffix[:j]))
    return m, pkgs


def _toplevel_names(path, cache):
    """-> (names, has_star_import) for the top level of `path`, memoised in `cache`.

    `names` covers defs, classes, plain/annotated assignments, and anything
    brought into scope by import/import-from - i.e. defined, imported, or
    re-exported. Every top-level COMPOUND statement is additionally flattened
    with a full `ast.walk`: `if`/`try` (conditional defs and try/except import
    fallbacks) but equally `for`/`while`/`with`, which bind top-level names
    just as effectively -

        with open(p) as f:
            CONFIG = json.load(f)

        for name in ("a", "b"):
            globals()[name] = make(name)

    - and were missed, so an importer of such a name was reported as broken.
    Under-counting names here is exactly the failure mode that manufactures a
    false positive, which is the one thing this checker claims not to do.
    """
    if path in cache:
        return cache[path]
    try:
        src = open(path, "r", encoding="utf-8", errors="replace").read()
        top = ast.parse(src)
    except Exception:
        cache[path] = None
        return None
    names = set()
    star = [False]

    def note(n):
        if isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            names.add(n.name)
        elif isinstance(n, ast.Assign):
            for tg in n.targets:
                if isinstance(tg, ast.Name):
                    names.add(tg.id)
        elif isinstance(n, ast.AnnAssign) and isinstance(n.target, ast.Name):
            names.add(n.target.id)
        elif isinstance(n, ast.Import):
            for al in n.names:
                names.add((al.asname or al.name).split(".")[0])
        elif isinstance(n, ast.ImportFrom):
            for al in n.names:
                if al.name == "*":
                    star[0] = True
                else:
                    names.add(al.asname or al.name)

    compound = (ast.If, ast.Try, ast.For, ast.AsyncFor, ast.While,
                ast.With, ast.AsyncWith)
    for n in top.body:
        note(n)
        if isinstance(n, compound):
            for sub in ast.walk(n):
                note(sub)
    cache[path] = (names, star[0])
    return cache[path]


def _resolves(mod, name, mm, cache):
    """True if `name` is visible on module `mod`: a submodule file, or defined/
    imported/re-exported at `mod`'s top level. False only when both checks
    have a definite answer and both say no.
    """
    if ("%s.%s" % (mod, name)) in mm:
        return True                   # `from pkg import sub` where sub is pkg/sub.py
    tgt = mm[mod]
    tn = _toplevel_names(tgt, cache)
    if tn is None:
        return True                   # unparsable: withhold judgement, no false positive
    names, star = tn
    if star:
        return True                   # `from elsewhere import *` in mod: can't rule out
    return name in names


def _broken_in_tree(root):
    """-> (set of (rel_path, module, name) that cannot resolve INSIDE this tree,
    py_files_examined, files_total). The counts come from the same walk that
    finds breakage: py_files_examined counts every .py encountered (parsable or
    not - an unparsable file was still examined and judgement withheld);
    files_total counts every file surviving the _BK_SKIP_DIRS pruning. Zero
    examined in a tree is the one state whose "no findings" means "no check",
    and the caller must be able to tell those apart.

    A finding is (path, module, name). An empty `name` means the import names
    no member - `import M` where M is not a module in this tree.

    A RELATIVE import is recorded under its source spelling (".util", "..pkg")
    rather than the absolute name it resolves to, and that is load-bearing for
    the subtraction rather than cosmetic. `git mv pkg/ core/` leaves the text
    of `from .util import helper` untouched while changing what it resolves to,
    so a finding keyed on the resolved name would read as "pkg.util" in one
    parent and "core.util" in the merge, cancel against nothing, and report a
    pure directory rename as new breakage. The source spelling is invariant
    under exactly the renames the path canonicalisation already handles.
    """
    mm, pkgs = _module_map(root)
    cache = {}
    out = set()
    py_examined = 0
    files_total = 0
    for dp, dn, fn in os.walk(root):
        dn[:] = [d for d in dn if d not in _BK_SKIP_DIRS]
        files_total += len(fn)
        for f in fn:
            if not f.endswith(".py"):
                continue
            py_examined += 1
            full = os.path.join(dp, f)
            try:
                src = open(full, "r", encoding="utf-8", errors="replace").read()
                tree = ast.parse(src)
            except Exception:
                continue
            rel = os.path.relpath(full, root)
            pkg = os.path.dirname(rel).replace(os.sep, ".")
            for n in ast.walk(tree):
                if isinstance(n, ast.ImportFrom):
                    mod = n.module or ""
                    label = mod
                    if n.level:                                # relative import
                        base = pkg.split(".") if pkg else []
                        if n.level > 1:
                            base = base[:len(base) - (n.level - 1)]
                        mod = ".".join([x for x in base if x] + ([mod] if mod else []))
                        label = "." * n.level + (n.module or "")
                    if mod not in mm:
                        # Not a module here. `os` and `numpy` land here in every
                        # tree and cancel in the subtraction; a module the peer
                        # deleted or moved lands here only in the merge, which
                        # is the whole point. A namespace package is the one
                        # absence that is not one: it imports fine at runtime
                        # and has no __init__.py whose exports could be read.
                        if mod not in pkgs:
                            for al in n.names:
                                out.add((rel, label, al.name))
                        continue
                    for al in n.names:
                        if al.name == "*":
                            continue                           # exports unknowable
                        if not _resolves(mod, al.name, mm, cache):
                            out.add((rel, label, al.name))
                elif isinstance(n, ast.Import):
                    for al in n.names:
                        if al.name in mm or al.name in pkgs:
                            continue                           # the module itself is here
                        if "." not in al.name:
                            out.add((rel, al.name, ""))
                            continue
                        mod, name = al.name.rsplit(".", 1)
                        if mod in mm:
                            if not _resolves(mod, name, mm, cache):
                                out.add((rel, mod, name))
                        elif mod not in pkgs:
                            out.add((rel, mod, name))
    return out, py_examined, files_total


DEFAULT_CHECKER_TIMEOUT = 60.0
NONZERO_NO_OUTPUT = "<checker exited nonzero, no stdout>"


def checker_timeout():
    v = os.environ.get("MOIRE_CHECKER_TIMEOUT")
    if v:
        try:
            return float(v)
        except ValueError:
            pass
    return DEFAULT_CHECKER_TIMEOUT


def run_checker(checker, directory, timeout):
    """Run the builtin AST checker, or an arbitrary shell command, over `directory`.

    -> (findings, coverage).

    findings is a frozenset: (path, module, name) tuples for the builtin
    checker, one string per non-blank stdout line for an external command. A
    nonzero exit with no stdout still counts as broken (via a fixed sentinel)
    so it participates correctly in the broken(merged)-broken(self)-broken(peer)
    set difference - equally-broken-everywhere cancels out instead of being
    misread as zero findings on every side.

    coverage is {"examined": int, "total": int} for the builtin checker - the
    count of .py files it read and of all files in the tree - and None for an
    external command, which has no channel to report one (its stdout lines are
    findings by contract). None means "the user explicitly configured this
    checker and owns its applicability"; 0 means "the default checker proved it
    could read nothing here".

    Raises on timeout (subprocess.TimeoutExpired) or spawn failure; callers
    must turn that into verdict "error", never into breakage.
    """
    if checker == "builtin-ast":
        broken, examined, total = _broken_in_tree(directory)
        return frozenset(broken), {"examined": examined, "total": total}
    # `checker` runs via a shell, so its pid is the SHELL's, not necessarily
    # the real checker's (a pipeline, or a shell that execs something that
    # forks) - killing just that pid on timeout can leave the actual checker
    # running, orphaned, still writing into the materialised tree we are
    # about to rmtree. start_new_session=True makes this process the leader
    # of a fresh process group (POSIX only), so killpg on timeout reaches the
    # whole tree of descendants at once. Where that is unavailable (no
    # os.setsid - non-POSIX platforms), fall back to killing just the one
    # pid: less thorough, never worse than before this fix.
    posix_group = hasattr(os, "setsid") and hasattr(os, "killpg")
    p = subprocess.Popen(checker, shell=True, cwd=directory,
                         stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         start_new_session=posix_group)
    try:
        out, _err = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        if posix_group:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except OSError:
                p.kill()
        else:
            p.kill()
        p.communicate()
        raise
    lines = set(ln for ln in out.decode("utf-8", "replace").split("\n") if ln.strip())
    if p.returncode != 0 and not lines:
        lines.add(NONZERO_NO_OUTPUT)
    return frozenset(lines), None


# ------------------------------------------------------- rename canonicalisation
#
# The subtraction `broken(merged) - broken(self) - broken(peer)` is a set
# difference over finding tuples, and a finding names a PATH. So a finding
# cancels only if it is spelled identically on both sides - and a rename
# respells it. Peer runs `git mv src/y.py src/z.py`; self is holding its own
# broken import in src/y.py; the merged tree carries that same breakage at
# src/z.py, which matches nothing in broken(self), and the pair is told it
# created a collision that one of them brought along. Reproduced: one rename
# manufactures one false finding per pre-existing finding in the renamed file,
# on `git mv` - the most ordinary thing an agent does - and on renames
# specifically, which is the mechanism's own headline example.
#
# The fix is to put both parents' findings into the MERGED tree's namespace
# before subtracting. git already knows the mapping; ask it.

def _rename_map(git, cwd, tree_from, tree_to):
    """-> {old_path: new_path} for every rename between two trees.

    Parsed from `git diff --name-status -M50% -z`. -z (rather than the
    tab-separated default) because core.quotePath is on by default and
    C-quotes any non-ASCII path, which would silently fail to match the
    checker's own spelling of it; with -z the fields arrive raw and
    NUL-separated. -M50% is git's own default rename threshold.

    Empty dict on any failure: canonicalisation degrades to the previous
    behaviour, which is a possible false positive - never to a blocked or
    errored verdict.
    """
    if not tree_from or not tree_to or tree_from == tree_to:
        return {}
    rc, out, _err = git(["diff", "--name-status", "-M50%", "-z", tree_from, tree_to], cwd=cwd)
    if rc != 0:
        return {}
    fields = [f for f in out.split("\0") if f != ""]
    rmap = {}
    i = 0
    while i < len(fields):
        status = fields[i]
        # R/C carry two paths (old, new); every other status carries one.
        if status[:1] in ("R", "C") and i + 2 < len(fields):
            rmap[fields[i + 1]] = fields[i + 2]
            i += 3
        else:
            i += 2
    return rmap


def _canonicalise_findings(findings, rmap):
    """Rewrite a parent's findings into the merged tree's namespace.

    -> (frozenset, number rewritten). Builtin findings are (path, module,
    name) tuples: element 0 is replaced when it is a renamed path. An
    external checker's findings are opaque lines, so only a line that STARTS
    with a renamed path, followed by end-of-line or one of ':', '(', ' ',
    '\\t', ',', is rewritten (longest matching old path first, so a rename of
    both `src/a` and `src/a/b.py` resolves to the more specific one). A line
    that merely mentions a renamed path somewhere in the middle is left
    alone: rewriting it would need to understand the checker's format, which
    is exactly what the --checker contract refuses to assume. That residual
    is documented in the contract - findings must be path-prefixed to be
    protected from renames.
    """
    if not rmap or not findings:
        return frozenset(findings), 0
    olds = sorted(rmap, key=len, reverse=True)
    out = set()
    n = 0
    for item in findings:
        if isinstance(item, tuple) and item:
            old = str(item[0])
            if old in rmap:
                out.add((rmap[old],) + tuple(item[1:]))
                n += 1
                continue
            out.add(item)
            continue
        if isinstance(item, str):
            rewritten = None
            for old in olds:
                if item.startswith(old):
                    rest = item[len(old):]
                    if rest == "" or rest[0] in ":( \t,":
                        rewritten = rmap[old] + rest
                        break
            if rewritten is not None:
                out.add(rewritten)
                n += 1
                continue
        out.add(item)
    return frozenset(out), n


def subtract_breakage(git, cwd, self_tree, peer_tree, merged_tree,
                      self_broken, peer_broken, merged_broken,
                      verdict, conflict_paths):
    """The whole judgement: broken(merged) - broken(self) - broken(peer).

    -> {"new_breakage": sorted list, "excluded": n, "renames": {...} or None,
    "canonicalised": {...} or None}.

    This is the ONE place the subtraction happens. `verify` calls it on two
    live worktrees' snapshots and `replay` on two supplied commits, so the
    corpus measurement and the shipped tool cannot drift apart: a published
    method section reading "moire replay over corpus X" is only honest if
    replay is the same mechanism, not a second implementation of it that
    happened to agree on the day it was written.

    Both parents' findings are respelled into the merged tree's namespace
    first, or a rename on either side stops them cancelling (see
    _rename_map). The maps are computed only when the merged tree is broken
    at all: with nothing to cancel there is nothing to canonicalise, and this
    is the hot path.
    """
    rmap_self, rmap_peer = {}, {}
    if merged_broken:
        rmap_self = _rename_map(git, cwd, self_tree, merged_tree)
        rmap_peer = _rename_map(git, cwd, peer_tree, merged_tree)
    self_broken_c, n_self_c = _canonicalise_findings(self_broken, rmap_self)
    peer_broken_c, n_peer_c = _canonicalise_findings(peer_broken, rmap_peer)
    new_breakage = merged_broken - self_broken_c - peer_broken_c
    excluded = 0
    if verdict == "conflict":
        # Breakage ON a conflicting path is the textual conflict restated,
        # not an extra semantic finding - drop it. What survives is breakage
        # on files entirely disjoint from the conflict, which the old
        # all-or-nothing gate never saw.
        cp = set(conflict_paths)
        kept = set()
        for x in new_breakage:
            first = x[0] if isinstance(x, (tuple, list)) and x else x
            if str(first) in cp:
                excluded += 1
            else:
                kept.add(x)
        new_breakage = kept
    out = {"new_breakage": _sorted_findings(new_breakage), "excluded": excluded,
           "renames": None, "canonicalised": None}
    if rmap_self or rmap_peer:
        out["renames"] = {"self": [[o, rmap_self[o]] for o in sorted(rmap_self)],
                          "peer": [[o, rmap_peer[o]] for o in sorted(rmap_peer)]}
    if n_self_c or n_peer_c:
        out["canonicalised"] = {"self": n_self_c, "peer": n_peer_c}
    return out


def _sorted_findings(findings):
    """-> a JSON-ready, deterministically ordered list of findings.

    builtin-ast findings are (path, module, name) tuples -> lists; an external
    checker's are whole stdout lines (strings), which list() would explode
    into characters. Types are homogeneous within one record (one checker per
    run), so the type-aware sort key is safe.
    """
    nb = [list(x) if isinstance(x, tuple) else x for x in findings]
    nb.sort(key=lambda x: [str(e) for e in x] if isinstance(x, list) else [x])
    return nb


# ------------------------------------------------------------------ finding id
#
# A stable id for "this collision", independent of WHEN it was observed. Built
# only from the two worktree paths and the contested paths themselves - never
# a tree OID, timestamp, or check_id, all of which change on every single
# check even when the underlying collision has not moved at all. That
# stability is what makes recurrence ("still there 20 checks later") and
# dissolution ("gone now") measurable - and what makes `report`'s
# distinct-finding count mean the same thing across the whole log.

def _finding_tokens(rec):
    """-> the sorted identity tokens for a check/verify record's finding, or []
    if there is nothing to name.

    A textual conflict names its own conflict_paths. A
    textual-clean-but-semantically-broken merge (verify only) names the
    new_breakage entries instead - ONE TOKEN PER BREAKAGE, the whole finding:
    the builtin checker's (path, module, name) triple joined with \\x1f, an
    external checker's raw line as-is. Clean-and-unbroken records get [].

    This used to keep only the PATH of each breakage (item[0]), which
    collapsed every distinct breakage in one file into a single identity:
    two different names going missing in the same file were one finding, and
    fixing one of them while the other persisted looked like the same
    unchanged finding. Distinct-finding counts (the kill-gate metric) were
    the direct casualty.

    Tokens must already be in the MERGED namespace when a rename
    canonicalisation runs upstream of them - the id names the breakage as the
    merged tree shows it, not as either parent spelled it.
    """
    paths = rec.get("conflict_paths") or []
    if paths:
        return sorted(paths)
    sem = rec.get("semantic") or {}
    breakage = sem.get("new_breakage") or []
    out = []
    for item in breakage:
        if isinstance(item, (list, tuple)):
            out.append("\x1f".join(str(e) for e in item))
        else:
            out.append(str(item))
    return sorted(out)


def compute_finding_id(self_worktree, peer_worktree, tokens):
    """-> 12-hex-char id, or None if `tokens` is empty (nothing to identify).

    MUST be symmetric: the same collision observed from either worktree has
    to yield the identical id, or `report`'s distinct-finding count would
    silently double-count every collision (once per side). Sorting the two
    worktree paths before hashing is what buys that - the pair {A, B} hashes
    the same regardless of which one is "self" for this call.

    Consequence of keying on the full tokens (see _finding_tokens): an
    EVOLVING collision - one whose contested path set or breakage set grows -
    is a NEW finding, not the old one seen again. That is the honest reading
    (the breakage really is different) and `report`'s distinct-finding count
    may therefore modestly over-count a collision that grew before it was
    resolved. It is only acceptable because nothing randomises on the id.
    """
    if not tokens:
        return None
    wt_a, wt_b = sorted((self_worktree, peer_worktree))
    h = hashlib.sha1()
    for part in (wt_a, wt_b, "\x1f\x1f".join(sorted(tokens))):
        h.update(part.encode("utf-8"))
        h.update(b"\x00")
    return h.hexdigest()[:12]


# -------------------------------------------------------------------- arbiter
#
# A recommendation, computed identically by both sides from facts each can
# observe about ITSELF and about the OTHER worktree directly - no declared
# state, no coordinating process, no CI/"finished-green" signal (that would
# require the peer to assert something about itself, which is exactly the
# self-report this project's own measurement showed makes things worse, not
# better: pre-write admission over declared scope has been measured to
# perform no better than no coordination at all -- see arXiv:2608.00947).
# Every rule below is symmetric by construction: it always
# picks the SAME worktree as the yielding one no matter which side's `moire`
# process evaluates it, because it only ever compares two absolute values
# (adoptable?, file count, commit count, name) that do not depend on which
# one is labelled "self" for this call.

def _is_adoptable(head, tree, head_tree):
    """True if `tree` (the full observed state: HEAD + staged + unstaged +
    untracked, from the same copied-index snapshot the oracle uses) is
    identical to the tree of the worktree's own HEAD commit - i.e. nothing
    uncommitted. Deliberately does NOT run `git status`: status can rewrite
    the target's real index (refreshing its stat cache), which would mutate
    the very worktree we are only supposed to be observing. `head`/`tree`/
    `head_tree` are all already-computed OIDs; this is a pure string compare.
    No HEAD at all (a brand-new repo) is never adoptable - there is nothing
    committed to adopt onto.
    """
    if not head or not tree:
        return False
    return head_tree is not None and head_tree == tree


def _diff_file_count(git, cwd, merge_base, commit):
    if not merge_base or not commit:
        return None
    out = git.out(["diff", "--name-only", merge_base, commit], cwd=cwd)
    if out is None:
        return None
    return len([ln for ln in out.split("\n") if ln.strip()])


def _commits_ahead(git, cwd, merge_base, commit):
    if not merge_base or not commit:
        return None
    out = git.out(["rev-list", "--count", "%s..%s" % (merge_base, commit)], cwd=cwd)
    if out is None:
        return None
    try:
        return int(out)
    except ValueError:
        return None


def compute_arbiter(git, top, self_info, peer_info, self_tree, self_commit, peer_tree, peer_commit):
    """-> the arbiter dict for a conflict/breakage record. `top` is the cwd
    plumbing runs in (self's worktree; shares the object store with every
    peer, so commit/tree OIDs from either side resolve from here). Never
    executes a rebase - this is a recommendation only, and `stack_viable`
    never attempts a trial rebase to answer itself (that would mutate
    state); it withholds ("unknown") rather than guess.
    """
    self_wt, peer_wt = self_info["worktree"], peer_info["worktree"]
    self_head, peer_head = self_info.get("head"), peer_info.get("head")

    self_head_tree = git.out(["rev-parse", self_head + "^{tree}"], cwd=top) if self_head else None
    peer_head_tree = git.out(["rev-parse", peer_head + "^{tree}"], cwd=top) if peer_head else None
    self_adoptable = _is_adoptable(self_head, self_tree, self_head_tree)
    peer_adoptable = _is_adoptable(peer_head, peer_tree, peer_head_tree)

    merge_base = (git.out(["merge-base", self_commit, peer_commit], cwd=top)
                  if self_commit and peer_commit else None)
    self_diff = _diff_file_count(git, top, merge_base, self_commit)
    peer_diff = _diff_file_count(git, top, merge_base, peer_commit)
    self_ahead = _commits_ahead(git, top, merge_base, self_commit)
    peer_ahead = _commits_ahead(git, top, merge_base, peer_commit)

    self_name = self_info.get("branch") or self_wt
    peer_name = peer_info.get("branch") or peer_wt
    if self_name == peer_name:
        self_name, peer_name = self_wt, peer_wt

    if self_adoptable != peer_adoptable:
        # Rule 1 - adoptability: the side WITHOUT fully-committed work yields
        # onto the side that has one.
        if self_adoptable:
            yield_side, reason = "peer", "adoptability: peer has uncommitted work, self is fully committed"
        else:
            yield_side, reason = "self", "adoptability: self has uncommitted work, peer is fully committed"
    elif self_diff is not None and peer_diff is not None and self_diff != peer_diff:
        # Rule 2 - diff size: the smaller diff yields (cheaper to replay).
        if self_diff < peer_diff:
            yield_side, reason = "self", "diff size: self changed fewer files (%d vs %d)" % (self_diff, peer_diff)
        else:
            yield_side, reason = "peer", "diff size: peer changed fewer files (%d vs %d)" % (peer_diff, self_diff)
    elif self_ahead is not None and peer_ahead is not None and self_ahead != peer_ahead:
        # Rule 3 - branch age: fewer commits ahead of the merge-base yields.
        if self_ahead < peer_ahead:
            yield_side, reason = "self", "branch age: self has fewer commits ahead (%d vs %d)" % (self_ahead, peer_ahead)
        else:
            yield_side, reason = "peer", "branch age: peer has fewer commits ahead (%d vs %d)" % (peer_ahead, self_ahead)
    else:
        # Rule 4 - deterministic tiebreak: lexicographically GREATER name
        # yields. Symmetric: whichever of the two literal strings is greater
        # always yields, regardless of which side is "self" for this call.
        if self_name > peer_name:
            yield_side, reason = "self", "tiebreak: self's name %r > peer's %r" % (self_name, peer_name)
        else:
            yield_side, reason = "peer", "tiebreak: peer's name %r > self's %r" % (peer_name, self_name)

    winner_adoptable = peer_adoptable if yield_side == "self" else self_adoptable
    if not winner_adoptable:
        stack_viable, stack_blocker = False, "winner has uncommitted work: nothing to rebase onto"
    else:
        stack_viable, stack_blocker = "unknown", None

    return {
        "yield": yield_side, "reason": reason,
        "stack_viable": stack_viable, "stack_blocker": stack_blocker,
        "inputs": {
            "self": {"name": self_info.get("branch"), "adoptable": self_adoptable,
                     "diff_files": self_diff, "commits_ahead": self_ahead},
            "peer": {"name": peer_info.get("branch"), "adoptable": peer_adoptable,
                     "diff_files": peer_diff, "commits_ahead": peer_ahead},
        },
    }


# ------------------------------------------------------------------- commands
#
# One argv parser for every command. A flag moire does not know, or a
# value-flag with nothing after it, is a REFUSAL (exit 2) - never a silent
# no-op. The three defects this closes were all silent successes: `check
# --block` looked like it installed a blocking mode and did nothing at all;
# `verify --checker` at the end of argv silently ran the builtin checker
# instead of the one the caller named; `verify --peers` at the end of argv
# silently fanned out to EVERY worktree instead of the one named. Each of
# those produced a confident, wrong-shaped answer that no output distinguished
# from the intended one.
#
# The refusal happens before the command body runs, so it is structurally
# impossible for a bad invocation to snapshot a worktree, touch the cache, or
# write a log shard. That is the constraint (refuse only on an unusable
# environment or a bad argument, and only before any state is written), made
# a property of control flow rather than a rule to remember.

COMMAND_USAGE = {
    "check": "usage: moire check [--json] [--peers a,b]",
    "verify": ("usage: moire verify [--json] [--peers a,b] [--checker <cmd>] "
               "[--link <name>]..."),
    "replay": ("usage: moire replay <rev-a> <rev-b> [--checker <cmd>] "
               "[--link <name>]... [--json]"),
    "report": "usage: moire report [--json]",
    "doctor": "usage: moire doctor",
    "install": "usage: moire install [--print-client-hooks]",
    "pending": "usage: moire pending [--json]",
    "compose": ("usage: moire compose <finding-id> "
                "[--action rebase|narrow|retarget|wait|proceed] [--json]"),
}


def _refuse(cmd, problem):
    """Write `problem` plus `cmd`'s one-line usage to stderr and exit 2.

    Raises rather than returns: a caller cannot forget to propagate it, and
    no code after the parse call can run on a refused invocation.
    """
    sys.stderr.write("moire: %s\n" % problem)
    sys.stderr.write("%s\n" % COMMAND_USAGE.get(cmd, "usage: moire %s" % cmd))
    raise SystemExit(2)


def _parse_argv(cmd, argv, value_flags=(), bool_flags=(), repeat_flags=(), positional=(0, 0)):
    """-> (opts, positionals), or exits 2 via _refuse().

    value_flags   flags taking one value; missing, or followed by something
                  that looks like another flag, refuses.
    bool_flags    presence flags.
    repeat_flags  value flags collected into a list, in argv order.
    positional    (min, max) count of bare arguments.

    opts is keyed by the flag spelling itself ("--json"), so a reader of the
    command body sees exactly the string a user types. Booleans default to
    False, value flags to None, repeat flags to [].
    """
    opts = {}
    for f in bool_flags:
        opts[f] = False
    for f in value_flags:
        opts[f] = None
    for f in repeat_flags:
        opts[f] = []
    pos = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            sys.stdout.write("%s\n" % COMMAND_USAGE.get(cmd, "usage: moire %s" % cmd))
            raise SystemExit(0)
        if a in bool_flags:
            opts[a] = True
            i += 1
            continue
        if a in value_flags or a in repeat_flags:
            if i + 1 >= len(argv) or argv[i + 1].startswith("--"):
                _refuse(cmd, "%s requires a value" % a)
            if a in repeat_flags:
                opts[a].append(argv[i + 1])
            else:
                opts[a] = argv[i + 1]
            i += 2
            continue
        if a.startswith("-"):
            _refuse(cmd, "unknown argument %r for %s" % (a, cmd))
        pos.append(a)
        i += 1
    lo, hi = positional
    if len(pos) > hi:
        _refuse(cmd, "unexpected argument %r for %s" % (pos[hi], cmd))
    if len(pos) < lo:
        _refuse(cmd, "%s needs %d argument(s), got %d" % (cmd, lo, len(pos)))
    return opts, pos


def _resolve_checker(git, cwd, flag_value):
    """-> (checker, source). Precedence: --checker flag > moire.checker > builtin-ast.

    Per-repo execution context comes from `git config`, NOT from a committed
    file. `.git/config` is never cloned, so a checkout cannot carry a command;
    and it lives in $GIT_COMMON_DIR, so one `git config moire.checker ...`
    covers every worktree of the swarm and every agent need only type `moire
    verify`. Setting it requires local write access to the clone - the same
    trust level as installing moire's hooks, and the deliberate contrast with
    the repo-controlled auto-executed code `doctor` warns about for
    core.hooksPath. `--checker builtin-ast` stays expressible to override a
    config back to the default.
    """
    if flag_value is not None:
        return flag_value, "flag"
    cfg = git.out(["config", "--get", "moire.checker"], cwd=cwd)
    if cfg:
        return cfg, "config"
    return "builtin-ast", "default"


def _resolve_links(git, cwd, flag_links):
    """-> (names, error_text). Links are the union of `--link` occurrences and
    `moire.link` config entries, flag order first, config entries deduped.

    An invalid name from EITHER source is refused identically (error_text
    non-None, caller writes it and returns 2 before any snapshot or log
    write): one predicate for both sources so the two can never disagree.
    """
    links = list(flag_links)
    for name in links:
        if not _valid_link_name(name):
            return None, ("moire: --link %r: name must be a single path component "
                          "(no '/', '\\', '.' or '..')\n" % name)
    rc_l, out_l, _err_l = git(["config", "--get-all", "moire.link"], cwd=cwd)
    for name in ([ln.strip() for ln in out_l.split("\n") if ln.strip()]
                 if rc_l == 0 else []):
        if not _valid_link_name(name):
            return None, ("moire: git config moire.link %r: name must be a single path "
                          "component (no '/', '\\', '.' or '..')\n" % name)
        if name not in links:
            links.append(name)
    return links, None


def _require_git(git):
    if git.path is None or git.version < MIN_GIT:
        have = ("%s (%s)" % (git.version_str, git.path)) if git.path else "none found"
        sys.stderr.write(
            "moire: git >= %d.%d is required; found %s\n"
            "    Legacy `git merge-tree` silently misses rename/rename, modify/delete\n"
            "    and binary conflicts. Refusing to emit a verdict rather than degrade.\n"
            "    Set MOIRE_GIT=/path/to/git or install a newer git.\n" % (MIN_GIT[0], MIN_GIT[1], have))
        return False
    return True


def cmd_check(git, argv):
    opts, _pos = _parse_argv("check", argv, bool_flags=("--json",),
                             value_flags=("--peers",))
    as_json = opts["--json"]
    peers_arg = opts["--peers"]
    if peers_arg is None:
        peers_arg = os.environ.get("MOIRE_PEERS")

    if not _require_git(git):
        return 2                      # refuse; write no log

    cwd = os.getcwd()
    top = git.out(["rev-parse", "--show-toplevel"], cwd=cwd)
    if not top:
        sys.stderr.write("moire: not inside a git worktree\n")
        return 2
    top = os.path.realpath(top)
    cd = common_dir(git, cwd)

    wts = list_worktrees(git, cwd)
    me = None
    for w in wts:
        if w["worktree"] == top:
            me = w
    if me is None:
        me = {"worktree": top, "head": git.out(["rev-parse", "HEAD"], cwd=cwd), "branch": None}

    if peers_arg:
        peers = []
        for p in peers_arg.split(","):
            p = p.strip()
            if not p:
                continue
            p = os.path.realpath(p)
            found = None
            for w in wts:
                if w["worktree"] == p:
                    found = w
            peers.append(found or {"worktree": p, "head": None, "branch": None})
    else:
        peers = [w for w in wts if w["worktree"] != top]

    check_id = str(uuid.uuid4())
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    records = []
    agent_id = os.environ.get("MOIRE_AGENT_ID")     # a provenance label recorded on OUR OWN record only;
                                                      # never read by any predicate (verdict, arbiter, finding_id)

    # Self is ALWAYS recomputed - never served from cache. The agent invoking
    # `moire check` just wrote; a stale self-snapshot is the one error that would
    # silently produce a wrong verdict. We still publish the result into the
    # cache (below) so THIS worktree, acting as somebody else's peer, is a
    # cache hit for them.
    try:
        my_tree, my_commit = snapshot(git, top)
        my_err = None
        if cd:
            idx_mtime, idx_size = _index_fingerprint(git, top)
            write_snapshot_cache(cd, top, my_tree, my_commit, me.get("head"), idx_mtime, idx_size)
    except Exception as ex:
        my_tree, my_commit, my_err = None, None, str(ex)

    for p in peers:
        t0 = time.time()
        phead = p.get("head")
        if phead is None and os.path.isdir(p["worktree"]):
            phead = git.out(["rev-parse", "HEAD"], cwd=p["worktree"])
        self_info = {"worktree": top, "branch": me.get("branch"), "head": me.get("head")}
        peer_info = {"worktree": p["worktree"], "branch": p.get("branch"), "head": phead}
        rec = {
            "v": 2, "check_id": check_id, "ts": ts, "repo_common_dir": cd,
            "self": {"worktree": top, "branch": me.get("branch"),
                     "head": me.get("head"), "tree": my_tree, "agent_id": agent_id},
            "peer": {"worktree": p["worktree"], "branch": p.get("branch"),
                     "head": phead, "tree": None},
            "verdict": "error", "conflict_paths": [],
            "git_version": git.version_str, "oracle": "merge-tree --write-tree",
            "duration_ms": 0, "error": None,
            # "peer" records that this pass STARTED from a cache hit;
            # "peer_recomputed" that a finding was then re-derived from a
            # fresh peer snapshot, so the verdict below is not the cache's.
            "cached": {"self": False, "peer": False, "peer_recomputed": False},
            "finding_id": None, "arbiter": None,
        }
        try:
            if my_err:
                raise RuntimeError("self snapshot failed: %s" % my_err)
            if not os.path.isdir(p["worktree"]):
                raise RuntimeError("peer worktree missing: %s" % p["worktree"])
            if cd:
                ptree, pcommit, peer_cached = snapshot_peer_cached(git, p["worktree"], cd, phead)
            else:
                ptree, pcommit = snapshot(git, p["worktree"])
                peer_cached = False
            rec["cached"]["peer"] = peer_cached
            verdict, paths = oracle(git, top, my_commit, pcommit)
            if verdict == "conflict" and peer_cached:
                # Never emit a finding a peer may already have withdrawn -
                # see snapshot_peer_fresh.
                ptree, pcommit = snapshot_peer_fresh(git, p["worktree"], cd, phead)
                rec["cached"]["peer_recomputed"] = True
                verdict, paths = oracle(git, top, my_commit, pcommit)
            rec["peer"]["tree"] = ptree
            rec["verdict"] = verdict
            rec["conflict_paths"] = paths
            fid = compute_finding_id(top, p["worktree"], _finding_tokens(rec))
            rec["finding_id"] = fid
            if fid:
                rec["arbiter"] = compute_arbiter(git, top, self_info, peer_info,
                                                 my_tree, my_commit, ptree, pcommit)
        except Exception as ex:
            rec["verdict"] = "error"
            rec["error"] = str(ex)
        rec["duration_ms"] = int((time.time() - t0) * 1000)
        records.append(rec)

    # one shard file per invocation - never a shared append file
    if cd:
        ld = log_dir(cd)
        try:
            os.makedirs(ld)
        except OSError:
            pass
        name = "%s-%d-%s.json" % (datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%f"),
                                  os.getpid(), uuid.uuid4().hex[:6])
        tmp = os.path.join(ld, "." + name + ".tmp")
        with open(tmp, "w") as f:
            json.dump(records, f)
        os.rename(tmp, os.path.join(ld, name))

    if as_json:
        sys.stdout.write(json.dumps(records, indent=2) + "\n")
    else:
        if not records:
            sys.stdout.write("moire: no peer worktrees\n")
        for r in records:
            peer = r["peer"]["worktree"]
            if r["verdict"] == "conflict":
                sys.stdout.write("CONFLICT with %s (%s) [finding %s]\n" %
                                 (peer, r["peer"]["branch"] or "detached", r.get("finding_id")))
                for pth in r["conflict_paths"]:
                    sys.stdout.write("    %s\n" % pth)
                arb = r.get("arbiter")
                if arb:
                    sys.stdout.write("  arbiter: %s yields (%s)\n" % (arb["yield"], arb["reason"]))
                sys.stdout.write("  actions: rebase onto theirs | narrow your change | "
                                 "retarget | wait for them to land | proceed\n")
            elif r["verdict"] == "error":
                sys.stdout.write("error   with %s: %s\n" % (peer, r["error"]))
            else:
                sys.stdout.write("clean   with %s\n" % peer)
    return 0                          # warn-only: always 0


def cmd_verify(git, argv):
    """Exact semantic check on the speculative tree `merge-tree` already produced.

    Per peer: snapshot both, run the textual oracle. If it conflicts, there is
    nothing to verify (it will not merge) - record that and stop. If clean,
    materialise self's tree, peer's tree, and the never-attempted merged tree
    into throwaway directories (no worktree, no checkout, nothing mutated), run
    the checker over each, and report new breakage = broken(merged) -
    broken(self) - broken(peer). Breakage already present in a parent is that
    agent's own problem, not a collision this pair created. Warn-only, like
    check: always exits 0.
    """
    opts, _pos = _parse_argv("verify", argv, bool_flags=("--json",),
                             value_flags=("--peers", "--checker"),
                             repeat_flags=("--link",))
    as_json = opts["--json"]
    peers_arg = opts["--peers"]
    if peers_arg is None:
        peers_arg = os.environ.get("MOIRE_PEERS")

    if not _require_git(git):
        return 2                      # refuse; write no log

    cwd = os.getcwd()
    top = git.out(["rev-parse", "--show-toplevel"], cwd=cwd)
    if not top:
        sys.stderr.write("moire: not inside a git worktree\n")
        return 2
    top = os.path.realpath(top)
    cd = common_dir(git, cwd)

    # Both resolutions are shared verbatim with `replay` - see _resolve_checker
    # and _resolve_links - so the corpus instrument reads the same per-repo
    # configuration the live tool does.
    checker, checker_source = _resolve_checker(git, cwd, opts["--checker"])
    links, link_err = _resolve_links(git, cwd, opts["--link"])
    if link_err:
        sys.stderr.write(link_err)
        return 2                      # refuse; write no log

    wts = list_worktrees(git, cwd)
    me = None
    for w in wts:
        if w["worktree"] == top:
            me = w
    if me is None:
        me = {"worktree": top, "head": git.out(["rev-parse", "HEAD"], cwd=cwd), "branch": None}

    if peers_arg:
        peers = []
        for p in peers_arg.split(","):
            p = p.strip()
            if not p:
                continue
            p = os.path.realpath(p)
            found = None
            for w in wts:
                if w["worktree"] == p:
                    found = w
            peers.append(found or {"worktree": p, "head": None, "branch": None})
    else:
        peers = [w for w in wts if w["worktree"] != top]

    check_id = str(uuid.uuid4())
    ts = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    records = []
    timeout = checker_timeout()
    agent_id = os.environ.get("MOIRE_AGENT_ID")     # a provenance label recorded on OUR OWN record only;
                                                      # never read by any predicate (verdict, arbiter, finding_id)

    # Self is ALWAYS recomputed - see cmd_check for why. Publish into the
    # cache too so this worktree is a cache hit when someone else's `moire
    # verify`/`check` treats it as a peer.
    try:
        my_tree, my_commit = snapshot(git, top)
        my_err = None
        if cd:
            idx_mtime, idx_size = _index_fingerprint(git, top)
            write_snapshot_cache(cd, top, my_tree, my_commit, me.get("head"), idx_mtime, idx_size)
    except Exception as ex:
        my_tree, my_commit, my_err = None, None, str(ex)

    # Self's materialised tree and checker result are identical for every peer:
    # materialise and check lazily on FIRST need, memoise for the rest of the
    # call, and clean the directory up once after the loop (checker cost goes
    # 3N -> 2N+1). Lazy so nothing is materialised at all when every peer
    # errors out before its semantic pass. Memoised only on success: a failed
    # self check is retried per peer, exactly like the old per-peer behaviour.
    self_state = {"dir": None, "broken": None, "linked": [], "coverage": None}

    def _self_checked():
        if self_state["broken"] is None:
            d = tempfile.mkdtemp(prefix="moire-verify-self-")
            try:
                materialize_tree(git, top, my_tree, d)
                self_linked = link_directories(d, top, links)
                broken, cov = run_checker(checker, d, timeout)
            except BaseException:     # KeyboardInterrupt too: self_state["dir"] is
                                      # still None here, so the outer finally would
                                      # never see this directory - clean it now.
                shutil.rmtree(d, ignore_errors=True)
                raise
            self_state["dir"] = d
            self_state["broken"] = broken
            self_state["linked"] = self_linked
            self_state["coverage"] = cov
        return self_state["broken"]

    try:
        for p in peers:
            t0 = time.time()
            phead = p.get("head")
            if phead is None and os.path.isdir(p["worktree"]):
                phead = git.out(["rev-parse", "HEAD"], cwd=p["worktree"])
            self_info = {"worktree": top, "branch": me.get("branch"), "head": me.get("head")}
            peer_info = {"worktree": p["worktree"], "branch": p.get("branch"), "head": phead}
            rec = {
                "v": 2, "check_id": check_id, "ts": ts, "repo_common_dir": cd,
                "self": {"worktree": top, "branch": me.get("branch"),
                         "head": me.get("head"), "tree": my_tree, "agent_id": agent_id},
                "peer": {"worktree": p["worktree"], "branch": p.get("branch"),
                         "head": phead, "tree": None},
                "verdict": "error", "conflict_paths": [],
                "git_version": git.version_str, "oracle": "merge-tree --write-tree",
                "duration_ms": 0, "error": None, "semantic": None,
                # see cmd_check for what peer/peer_recomputed each mean
                "cached": {"self": False, "peer": False, "peer_recomputed": False},
                "finding_id": None, "arbiter": None,
            }
            tmp_dirs = []

            def _evaluate(ptree, pcommit):
                """One complete evaluation of this peer snapshot: the textual
                oracle, then the semantic pass when it applies. -> (verdict,
                paths, semantic dict or None).

                A function, not straight-line code, because it may have to run
                TWICE: a finding derived from a cached peer snapshot is
                re-derived against a fresh one before it is emitted (F7). Both
                passes append their materialised directories to `tmp_dirs`,
                which the caller's finally clears.
                """
                verdict, paths, merged_tree = oracle_tree(git, top, my_commit, pcommit)
                if not (verdict == "clean" or (verdict == "conflict" and checker == "builtin-ast")):
                    # Under a textual conflict, merge-tree still writes a merged
                    # tree - conflicting paths carry baked-in conflict markers. Only
                    # builtin-ast is safe on such a tree: a marker-laden .py is
                    # unparsable, so the checker withholds judgement for it and its
                    # importers (zero false positives by construction). An external
                    # checker would emit a syntax-error cascade whose diagnostics
                    # land in importers - paths NOT in conflict_paths - so for an
                    # external checker the semantic pass stays skipped (None).
                    return verdict, paths, None
                # Self is materialised and checked ONCE per verify (memoised):
                # the first peer to need it pays the full cost, recorded as
                # self_duration_ms; peers reusing the memo record 0. duration_ms
                # below is therefore MARGINAL per peer and comparable across
                # peers - it never absorbs the shared self pass.
                paid_self = self_state["broken"] is None
                t_self = time.time()
                self_broken = _self_checked()
                self_ms = int((time.time() - t_self) * 1000) if paid_self else 0
                t1 = time.time()
                peer_dir = tempfile.mkdtemp(prefix="moire-verify-peer-")
                merged_dir = tempfile.mkdtemp(prefix="moire-verify-merged-")
                tmp_dirs.extend([peer_dir, merged_dir])
                materialize_tree(git, top, ptree, peer_dir)
                materialize_tree(git, top, merged_tree, merged_dir)
                # sources per tree: self <- self's worktree, peer <- the
                # peer's worktree, merged <- self's worktree (a deliberate
                # approximation - see link_directories).
                peer_linked = link_directories(peer_dir, p["worktree"], links)
                merged_linked = link_directories_union(merged_dir, top, p["worktree"], links)
                peer_broken, peer_cov = run_checker(checker, peer_dir, timeout)
                merged_broken, merged_cov = run_checker(checker, merged_dir, timeout)
                # The subtraction itself - rename canonicalisation included -
                # is shared verbatim with `replay`, so the corpus measurement
                # and the live tool cannot drift apart. See subtract_breakage.
                sub = subtract_breakage(git, top, my_tree, ptree, merged_tree,
                                        self_broken, peer_broken, merged_broken,
                                        verdict, paths)
                nb = sub["new_breakage"]
                excluded = sub["excluded"]
                # The builtin checker reports how much of the tree it could
                # read; an external checker has no channel to (coverage is
                # None) and its applicability is the user's explicit choice.
                # `performed` keys on the MERGED tree only - that is the tree
                # the top-level claim is about. A peer adding the repo's
                # first .py file gives self coverage 0 / merged coverage 1,
                # and self_broken == 0 is then genuinely true (no imports
                # exist to break), so the set difference stays exact.
                performed = (merged_cov is None) or (merged_cov["examined"] > 0)
                sem = {
                    "checker": checker,
                    "checker_source": checker_source,
                    # Stored, not derived at read time: this is the
                    # load-bearing bit for the Phase 1 base rate, and
                    # `report` must not be able to misderive it.
                    "performed": performed,
                    "coverage": None if merged_cov is None else {
                        "self": self_state["coverage"],
                        "peer": peer_cov,
                        "merged": merged_cov,
                    },
                    "merged_tree": merged_tree,
                    "new_breakage": nb,
                    "self_broken": len(self_broken),
                    "peer_broken": len(peer_broken),
                    "merged_broken": len(merged_broken),
                    "duration_ms": int((time.time() - t1) * 1000),
                    "self_duration_ms": self_ms,
                    # Per tree, never summed into one list: an asymmetry (e.g.
                    # the peer tree got no link because the peer worktree
                    # lacks the directory) is exactly what explains a
                    # checker's output failing to cancel - a single union
                    # list would hide it. self/peer stay plain name lists;
                    # merged carries provenance per name, because the merged
                    # tree is the only one that had to borrow from two places
                    # at once.
                    "linked": {"self": sorted(self_state["linked"]),
                               "peer": sorted(peer_linked),
                               "merged": merged_linked},
                }
                if sub["renames"]:
                    sem["renames"] = sub["renames"]
                if sub["canonicalised"]:
                    sem["canonicalised"] = sub["canonicalised"]
                if verdict == "conflict":
                    # Omitted entirely on the clean path so existing records
                    # stay comparable.
                    sem["under_conflict"] = True
                    sem["excluded_conflict_paths"] = excluded
                return verdict, paths, sem

            try:
                if my_err:
                    raise RuntimeError("self snapshot failed: %s" % my_err)
                if not os.path.isdir(p["worktree"]):
                    raise RuntimeError("peer worktree missing: %s" % p["worktree"])
                if cd:
                    ptree, pcommit, peer_cached = snapshot_peer_cached(git, p["worktree"], cd, phead)
                else:
                    ptree, pcommit = snapshot(git, p["worktree"])
                    peer_cached = False
                rec["cached"]["peer"] = peer_cached
                verdict, paths, sem = _evaluate(ptree, pcommit)
                if peer_cached and (verdict == "conflict" or (sem and sem.get("new_breakage"))):
                    # Never emit a finding a peer may already have withdrawn -
                    # see snapshot_peer_fresh. The whole pass repeats, semantic
                    # side included: the merged tree itself changes when the
                    # peer's does.
                    ptree, pcommit = snapshot_peer_fresh(git, p["worktree"], cd, phead)
                    rec["cached"]["peer_recomputed"] = True
                    verdict, paths, sem = _evaluate(ptree, pcommit)
                rec["peer"]["tree"] = ptree
                rec["verdict"] = verdict
                rec["conflict_paths"] = paths
                rec["semantic"] = sem
                fid = compute_finding_id(top, p["worktree"], _finding_tokens(rec))
                rec["finding_id"] = fid
                if fid:
                    rec["arbiter"] = compute_arbiter(git, top, self_info, peer_info,
                                                     my_tree, my_commit, ptree, pcommit)
            except Exception as ex:
                rec["verdict"] = "error"      # covers a checker timeout too - never breakage
                rec["semantic"] = None
                rec["error"] = str(ex)
            finally:
                for d in tmp_dirs:
                    shutil.rmtree(d, ignore_errors=True)
            rec["duration_ms"] = int((time.time() - t0) * 1000)
            records.append(rec)
    finally:
        if self_state["dir"]:
            shutil.rmtree(self_state["dir"], ignore_errors=True)

    # one log shard file per invocation - never a shared append - same layout as check
    if cd:
        ld = log_dir(cd)
        try:
            os.makedirs(ld)
        except OSError:
            pass
        name = "%s-%d-%s.json" % (datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%f"),
                                  os.getpid(), uuid.uuid4().hex[:6])
        tmp = os.path.join(ld, "." + name + ".tmp")
        with open(tmp, "w") as f:
            json.dump(records, f)
        os.rename(tmp, os.path.join(ld, name))

    def _linked_union_lines(sem):
        """Say when the merged tree's linked directory had to be assembled
        from both worktrees. Informational, never a finding: it explains what
        the checker was given to read, which is the difference between a real
        finding and an artifact of where the borrowed directory came from.
        """
        merged = ((sem or {}).get("linked") or {}).get("merged")
        if not isinstance(merged, dict):
            return
        for name in sorted(merged):
            prov = merged[name]
            if not isinstance(prov, dict) or prov.get("mode") != "union":
                continue
            from_peer = prov.get("from_peer") or []
            count = prov.get("peer_only_count", len(from_peer))
            shown = ", ".join(from_peer)
            if count > len(from_peer):
                shown += " +%d more" % (count - len(from_peer))
            sys.stdout.write("  linked directory %r: merged tree used self's, plus %d entry/entries "
                             "only the peer has (%s)\n" % (name, count, shown))

    if as_json:
        sys.stdout.write(json.dumps(records, indent=2) + "\n")
    else:
        if not records:
            sys.stdout.write("moire: no peer worktrees\n")
        for r in records:
            peer = r["peer"]["worktree"]
            if r["verdict"] == "conflict":
                sem = r.get("semantic")
                sys.stdout.write("CONFLICT with %s (%s) [finding %s]\n" %
                                 (peer, r["peer"]["branch"] or "detached", r.get("finding_id")))
                if sem is None:
                    sys.stdout.write("  semantic check not attempted: external checker cannot be "
                                     "trusted on a tree containing conflict markers "
                                     "(%d conflicting paths)\n" % len(r["conflict_paths"]))
                elif not sem.get("performed", True):
                    # The builtin ran but could read nothing: say so instead of
                    # letting the silence read as "semantically fine".
                    mcov = (sem.get("coverage") or {}).get("merged") or {}
                    sys.stdout.write(
                        "  semantic check not performed: builtin-ast examined 0 of %d files in "
                        "the merged tree (it reads only Python; this tree has no .py files)\n"
                        % mcov.get("total", 0))
                for pth in r["conflict_paths"]:
                    sys.stdout.write("    %s\n" % pth)
                arb = r.get("arbiter")
                if arb:
                    sys.stdout.write("  arbiter: %s yields (%s)\n" % (arb["yield"], arb["reason"]))
                new = (sem or {}).get("new_breakage") or []
                if new:
                    # The builtin ran under the conflict and found breakage on
                    # files disjoint from it - two dimensions of one finding,
                    # so both blocks print for this peer.
                    sys.stdout.write("BROKEN  with %s (%d new breakage(s), merged tree %s) [finding %s]\n" %
                                     (peer, len(new), sem.get("merged_tree"), r.get("finding_id")))
                    for item in new:
                        sys.stdout.write("    %s\n" %
                                         (tuple(item) if isinstance(item, list) else item,))
            elif r["verdict"] == "error":
                sys.stdout.write("error   with %s: %s\n" % (peer, r["error"]))
            else:
                sem = r["semantic"] or {}
                new = sem.get("new_breakage") or []
                if new:
                    sys.stdout.write("BROKEN  with %s (%d new breakage(s), merged tree %s) [finding %s]\n" %
                                     (peer, len(new), sem.get("merged_tree"), r.get("finding_id")))
                    for item in new:
                        # builtin findings are lists (JSON round-trip of tuples);
                        # an external checker's finding is one raw string line.
                        sys.stdout.write("    %s\n" %
                                         (tuple(item) if isinstance(item, list) else item,))
                    arb = r.get("arbiter")
                    if arb:
                        sys.stdout.write("  arbiter: %s yields (%s)\n" % (arb["yield"], arb["reason"]))
                else:
                    # The leading token stays `clean`: the textual verdict IS
                    # clean and true, and it is the grammar `check` shares. What
                    # was false was the parenthetical claim, so the claim moves
                    # to where the truth is - on the same line, the same
                    # precedent as the not-attempted line above. An LLM reads
                    # the whole line; what it must be unable to extract from a
                    # tree nothing could read is the string "semantic ok".
                    cov = sem.get("coverage") or {}
                    mcov = cov.get("merged") or {}
                    if not sem.get("performed", True):
                        sys.stdout.write(
                            "clean   with %s (textual only - no semantic check was performed)\n"
                            % peer)
                        sys.stdout.write(
                            "  builtin-ast examined 0 of %d files: it reads only Python and this "
                            "tree has no .py files.\n" % mcov.get("total", 0))
                        sys.stdout.write(
                            "  The merged result was NOT semantically verified - \"clean\" above "
                            "means only that git found no textual conflict.\n")
                        sys.stdout.write(
                            "  To enable semantic verification for this repo: "
                            "git config moire.checker '<command>'   "
                            "(README: the --checker contract)\n")
                    elif mcov:
                        # "findings", not "broken": the per-tree counts include
                        # every import the checker could not resolve inside a
                        # tree, which for the builtin checker means every
                        # stdlib and third-party import in the repository. They
                        # cancel, and saying "merged=23631 broken" next to
                        # "semantic ok" would read as a contradiction to a
                        # human and to an LLM. The judgement is the difference.
                        sys.stdout.write(
                            "clean   with %s (semantic ok: no new breakage; findings "
                            "self=%d peer=%d merged=%d; "
                            "builtin-ast examined %d of %d files - python only)\n" %
                            (peer, sem.get("self_broken", 0), sem.get("peer_broken", 0),
                             sem.get("merged_broken", 0),
                             mcov.get("examined", 0), mcov.get("total", 0)))
                    else:
                        # External checker (or a pre-coverage record): no
                        # coverage channel exists, so claim nothing about scope.
                        sys.stdout.write(
                            "clean   with %s (semantic ok: no new breakage; findings "
                            "self=%d peer=%d merged=%d)\n" %
                            (peer, sem.get("self_broken", 0), sem.get("peer_broken", 0),
                             sem.get("merged_broken", 0)))
            _linked_union_lines(r.get("semantic"))
    return 0                          # warn-only: always 0


def cmd_replay(git, argv):
    """The exact `verify` mechanism on two supplied COMMITS instead of two live
    worktrees.

    `verify` can only measure what somebody is doing right now, in a worktree
    on this machine, which makes the number it exists to justify - the
    semantic base rate for textually clean concurrent agent work - conditional
    on adopters. `replay` removes that condition: point it at two commits from
    a public corpus of agent pull requests and the same textual oracle, the
    same materialisation, the same checker and the same canonicalised
    subtraction produce the same record. The measurement is then the shipped
    mechanism, not a script that reimplements it, and the published method
    reduces to "moire replay over corpus X".

    Stateless by construction, because a measurement instrument that leaves
    state behind contaminates the next reading: no log shard, no snapshot
    cache entry, no `git add -A` snapshot, no worktree, no index, no ref. It
    reads the object store and writes throwaway directories under $TMPDIR.
    (`merge-tree --write-tree` does add one tree object to the store - that IS
    the oracle, and it is unreachable from any ref; `git gc` collects it.)

    Warn-only like everything else: always exits 0 once it has started, and
    refuses with 2 only on an unusable environment or a bad argument.
    """
    opts, pos = _parse_argv("replay", argv, bool_flags=("--json",),
                            value_flags=("--checker",), repeat_flags=("--link",),
                            positional=(2, 2))
    as_json = opts["--json"]
    rev_a, rev_b = pos[0], pos[1]

    if not _require_git(git):
        return 2                      # refuse; nothing written

    cwd = os.getcwd()
    # NOT `rev-parse --show-toplevel`, which is what check/verify gate on. A
    # bare clone is the corpus harness's normal environment (`git clone --bare
    # --filter=blob:none`) and a bare repo HAS no worktree, so the worktree
    # gate would refuse in exactly the place the measurement runs. What replay
    # needs is the OBJECT STORE: merge-tree, archive and diff all work bare.
    if git.out(["rev-parse", "--git-dir"], cwd=cwd) is None:
        sys.stderr.write("moire: not inside a git repository\n")
        return 2
    top = git.out(["rev-parse", "--show-toplevel"], cwd=cwd)
    # The anchor is only ever "some path inside the repo" for git to find the
    # object store from; in a bare repo that is the repo directory itself.
    anchor = os.path.realpath(top) if top else cwd

    commit_a = git.out(["rev-parse", "--verify", "--quiet", "%s^{commit}" % rev_a], cwd=cwd)
    if not commit_a:
        _refuse("replay", "cannot resolve %r to a commit" % rev_a)
    commit_b = git.out(["rev-parse", "--verify", "--quiet", "%s^{commit}" % rev_b], cwd=cwd)
    if not commit_b:
        _refuse("replay", "cannot resolve %r to a commit" % rev_b)

    checker, checker_source = _resolve_checker(git, cwd, opts["--checker"])
    links, link_err = _resolve_links(git, cwd, opts["--link"])
    if link_err:
        sys.stderr.write(link_err)
        return 2                      # refuse; nothing written

    timeout = checker_timeout()
    t0 = time.time()
    tree_a = git.out(["rev-parse", "--verify", "--quiet", "%s^{tree}" % commit_a], cwd=cwd)
    tree_b = git.out(["rev-parse", "--verify", "--quiet", "%s^{tree}" % commit_b], cwd=cwd)
    rec = {
        "v": 2, "mode": "replay",
        "ts": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        # `rev` is what the caller typed, `commit` what it resolved to: a
        # corpus record has to be re-runnable months later, when refs/moire/A
        # no longer exists but the OID still names the same state.
        "self": {"rev": rev_a, "commit": commit_a, "tree": tree_a},
        "peer": {"rev": rev_b, "commit": commit_b, "tree": tree_b},
        "verdict": "error", "conflict_paths": [],
        "git_version": git.version_str, "oracle": "merge-tree --write-tree",
        # Recorded, not left to the harness to recompute: the pre-registered
        # attrition table has "merge-base found" as its own stage, and a table
        # derived from the JSONL alone is a table a reader can check.
        "merge_base": git.out(["merge-base", commit_a, commit_b], cwd=anchor),
        "duration_ms": 0, "error": None, "semantic": None,
        "finding_id": None,
    }

    tmp_dirs = []
    try:
        verdict, paths, merged_tree = oracle_tree(git, anchor, commit_a, commit_b)
        rec["verdict"] = verdict
        rec["conflict_paths"] = paths
        # Same gate as verify: under a textual conflict merge-tree still
        # writes a tree, with conflict markers baked into the conflicting
        # paths. Only builtin-ast is safe to read it (a marker-laden .py is
        # unparsable, so it withholds judgement for that file and its
        # importers); an external checker would emit a syntax-error cascade
        # landing on paths that are NOT in conflict_paths.
        if verdict == "clean" or (verdict == "conflict" and checker == "builtin-ast"):
            self_dir = tempfile.mkdtemp(prefix="moire-replay-self-")
            peer_dir = tempfile.mkdtemp(prefix="moire-replay-peer-")
            merged_dir = tempfile.mkdtemp(prefix="moire-replay-merged-")
            tmp_dirs.extend([self_dir, peer_dir, merged_dir])
            materialize_tree(git, anchor, tree_a, self_dir)
            materialize_tree(git, anchor, tree_b, peer_dir)
            materialize_tree(git, anchor, merged_tree, merged_dir)
            # A commit has no worktree of its own to borrow an untracked
            # dependency directory from, so all three trees borrow from the
            # CWD's worktree if there is one. Recorded per tree, like verify.
            # The corpus harness never uses --link (tier 2 installs per
            # materialised tree, tier 1 needs nothing), so this path is for
            # interactive use.
            linked = {}
            for label, d in (("self", self_dir), ("peer", peer_dir), ("merged", merged_dir)):
                linked[label] = sorted(link_directories(d, anchor, links)) if links else []
            self_broken, self_cov = run_checker(checker, self_dir, timeout)
            peer_broken, peer_cov = run_checker(checker, peer_dir, timeout)
            merged_broken, merged_cov = run_checker(checker, merged_dir, timeout)
            # Coherence guard. A merge of two non-empty trees cannot be
            # empty, so a merged tree the checker found NO files in means the
            # materialisation was truncated (a full disk, a killed tar),
            # not that this pair had nothing to check. Without this the
            # record would say `performed: false` and the pair would leave
            # the measurement's denominator silently - the failure mode that
            # shrinks a base rate's denominator without shrinking anything
            # visible. Observed once on a monorepo under disk pressure while
            # building this, which is why it is a check and not a comment.
            # Only expressible for the builtin checker: an external one has
            # no coverage channel, so the same truncation there is
            # undetectable and is a documented limit.
            if (merged_cov is not None and merged_cov["total"] == 0
                    and ((self_cov and self_cov["total"]) or (peer_cov and peer_cov["total"]))):
                raise RuntimeError(
                    "merged tree materialised empty (%d/%d files in the parents): "
                    "refusing to report it as 'nothing to check'"
                    % ((self_cov or {}).get("total", 0), (peer_cov or {}).get("total", 0)))
            sub = subtract_breakage(git, anchor, tree_a, tree_b, merged_tree,
                                    self_broken, peer_broken, merged_broken,
                                    verdict, paths)
            # Nondeterminism control, pre-registered: when - and only when -
            # a breakage survives the subtraction, the MERGED tree's checker
            # runs twice more and only findings present in all three runs are
            # kept. A checker that emits a timestamp, a hash-ordered set or a
            # flaky diagnostic would otherwise contribute a "new breakage"
            # that nothing in the pair caused. Discards are recorded, never
            # silently dropped. Live `verify` does not pay this: the control
            # belongs to the measurement, where a false positive costs a
            # published number rather than one ignorable warning.
            runs, discarded = 1, []
            if sub["new_breakage"]:
                stable = merged_broken
                for _ in range(2):
                    again, _cov = run_checker(checker, merged_dir, timeout)
                    stable = stable & again
                    runs += 1
                if stable != merged_broken:
                    before = sub["new_breakage"]
                    sub = subtract_breakage(git, anchor, tree_a, tree_b, merged_tree,
                                            self_broken, peer_broken, stable,
                                            verdict, paths)
                    kept = [json.dumps(x) for x in sub["new_breakage"]]
                    discarded = [x for x in before if json.dumps(x) not in kept]
                    # Every count in the record describes the SAME finding set
                    # the verdict describes - the one that survived all three
                    # runs. A merged_broken from run 1 next to a new_breakage
                    # from the intersection would not subtract to each other
                    # on anyone's arithmetic.
                    merged_broken = stable
            performed = (merged_cov is None) or (merged_cov["examined"] > 0)
            sem = {
                "checker": checker,
                "checker_source": checker_source,
                "performed": performed,
                "coverage": None if merged_cov is None else {
                    "self": self_cov, "peer": peer_cov, "merged": merged_cov},
                "merged_tree": merged_tree,
                "new_breakage": sub["new_breakage"],
                "self_broken": len(self_broken),
                "peer_broken": len(peer_broken),
                "merged_broken": len(merged_broken),
                "merged_checker_runs": runs,
                "nondeterministic_discarded": discarded,
                "duration_ms": int((time.time() - t0) * 1000),
                "linked": linked,
            }
            if sub["renames"]:
                sem["renames"] = sub["renames"]
            if sub["canonicalised"]:
                sem["canonicalised"] = sub["canonicalised"]
            if verdict == "conflict":
                sem["under_conflict"] = True
                sem["excluded_conflict_paths"] = sub["excluded"]
            rec["semantic"] = sem
        # The pair is named by the two revs, where verify names it by the two
        # worktree paths; sorted inside compute_finding_id either way, so
        # replaying B,A yields the identical id for the identical finding.
        rec["finding_id"] = compute_finding_id(commit_a, commit_b, _finding_tokens(rec))
    except Exception as ex:
        # Includes a checker timeout and a merge-tree hard failure (unrelated
        # histories, a corrupt object). An unusable pair is an `error` record
        # the attrition table can count - never breakage, and never a nonzero
        # exit that would stop a corpus run partway through.
        rec["verdict"] = "error"
        rec["semantic"] = None
        rec["error"] = str(ex)
    finally:
        for d in tmp_dirs:
            shutil.rmtree(d, ignore_errors=True)
    rec["duration_ms"] = int((time.time() - t0) * 1000)

    if as_json:
        sys.stdout.write(json.dumps(rec, indent=2) + "\n")
    else:
        short = "%s..%s" % (commit_a[:7], commit_b[:7])
        sem = rec["semantic"] or {}
        new = sem.get("new_breakage") or []
        if rec["verdict"] == "error":
            sys.stdout.write("error   %s: %s\n" % (short, rec["error"]))
        else:
            if rec["verdict"] == "conflict":
                sys.stdout.write("conflict %s (%d path(s))\n" % (short, len(rec["conflict_paths"])))
                for pth in rec["conflict_paths"]:
                    sys.stdout.write("    %s\n" % pth)
            if new:
                sys.stdout.write("BROKEN  %s (%d new breakage(s), merged tree %s) [finding %s]\n" %
                                 (short, len(new), sem.get("merged_tree"), rec["finding_id"]))
                for item in new:
                    sys.stdout.write("    %s\n" %
                                     (tuple(item) if isinstance(item, list) else item,))
            elif rec["verdict"] == "clean":
                mcov = (sem.get("coverage") or {}).get("merged") or {}
                if not sem.get("performed", True):
                    # Never let silence read as "semantically fine" - the same
                    # rule verify follows.
                    sys.stdout.write("clean   %s (textual only - no semantic check was "
                                     "performed)\n" % short)
                    sys.stdout.write("  builtin-ast examined 0 of %d files: it reads only Python "
                                     "and this tree has no .py files.\n" % mcov.get("total", 0))
                elif mcov:
                    # Same wording as verify, for the same reason: these are
                    # unresolved findings per tree, most of them ambient, and
                    # only their difference is a judgement.
                    sys.stdout.write("clean   %s (semantic ok: no new breakage; findings "
                                     "self=%d peer=%d merged=%d; "
                                     "builtin-ast examined %d of %d files - python only)\n" %
                                     (short, sem.get("self_broken", 0), sem.get("peer_broken", 0),
                                      sem.get("merged_broken", 0),
                                      mcov.get("examined", 0), mcov.get("total", 0)))
                else:
                    sys.stdout.write("clean   %s (semantic ok: no new breakage; findings "
                                     "self=%d peer=%d merged=%d)\n" %
                                     (short, sem.get("self_broken", 0), sem.get("peer_broken", 0),
                                      sem.get("merged_broken", 0)))
    return 0                          # warn-only: always 0


def cmd_doctor(git, argv):
    _parse_argv("doctor", argv)
    cwd = os.getcwd()
    healthy = [True]

    def say(good, label, detail=""):
        # Three states: True -> [ok], False -> [FAIL] (clears healthy, nonzero
        # exit), "warn" -> [warn] (observational; never touches the exit code).
        if good == "warn":
            tag = "warn"
        else:
            healthy[0] = healthy[0] and good
            tag = "ok" if good else "FAIL"
        sys.stdout.write("[%s] %s%s\n" % (tag, label,
                                          (" - " + detail) if detail else ""))

    good = git.path is not None and git.version >= MIN_GIT
    say(good, "git >= %d.%d" % MIN_GIT,
        ("%s at %s" % (git.version_str, git.path)) if git.path else "not found")

    top = git.out(["rev-parse", "--show-toplevel"], cwd=cwd) if git.path else None
    say(top is not None, "inside a git worktree", top or "no")
    if not top:
        return 1
    cd = common_dir(git, cwd)
    say(cd is not None and os.path.isdir(cd), "git common dir resolved", cd or "no")
    if not cd or not os.path.isdir(cd):
        return 1                      # everything below dereferences cd

    hp = git.out(["config", "--get", "core.hooksPath"], cwd=cwd)
    say(not hp, "core.hooksPath unset",
        "SET TO %r - this silently disables hooks in linked worktrees and lets any "
        "branch execute code on commit; run: git config --unset core.hooksPath" % hp if hp else "")

    for h in HOOKS:
        pth = os.path.join(cd, "hooks", h)
        present = os.path.exists(pth) and HOOK_MARKER in open(pth).read()
        say(present, "hook installed: %s" % h, pth)

    b = installed_bin(cd)
    say(os.path.exists(b) and os.access(b, os.X_OK), "binary installed", b)

    ld = log_dir(cd)
    writable = True
    try:
        os.makedirs(ld)
    except OSError:
        pass
    try:
        probe = os.path.join(ld, ".probe")
        open(probe, "w").close()
        os.unlink(probe)
    except Exception as ex:
        writable = False
        say(False, "state dir writable", str(ex))
    if writable:
        say(True, "state dir writable", ld)

    # The one operation everything else depends on, exercised for real rather
    # than assumed. `check` and `verify` are warn-only by design: a snapshot
    # that fails is caught, recorded as verdict "error", and exits 0 - so a
    # universally failing snapshot (an unwritable object store, a git that
    # rejects the fixed SNAPSHOT_ENV dates, a broken index) turns moire into a
    # silent no-op rather than anything anyone would notice. Containment is not
    # detectability; this line is where that failure becomes visible.
    #
    # [FAIL], not [warn]: unlike every other check here, nothing works after
    # this one breaks. Uses the same never-mutate path as check/verify - a copy
    # of the index, discarded - so running doctor changes nothing observable.
    if top:
        try:
            t_probe, c_probe = snapshot(git, top)
            if not t_probe or not c_probe:
                raise RuntimeError("empty tree or commit id")
            say(True, "snapshot works", "tree %s" % t_probe[:12])
        except Exception as ex:
            say(False, "snapshot works",
                "%s - check/verify would report verdict 'error' for every peer "
                "and still exit 0" % ex)

    # Object-store pressure. Snapshot commits are content-addressed (SNAPSHOT_ENV
    # pins the dates), so an idle swarm writes nothing; what remains is one
    # blob/tree/commit set per distinct observed state, all of it refless and
    # therefore reclaimable by git's own housekeeping - which normal commit/merge/
    # fetch activity already triggers. This line exists for the pessimistic case:
    # a git old enough that the auto-sweep packs reachable objects only, or a
    # workflow that genuinely never commits.
    #
    # Threshold is git's own `gc.auto` (default 6700), not a moire invention, so
    # `gc.auto=0` - the user explicitly disabling gc - disables this warn too,
    # matching git's meaning. Advisory only: git's real trigger is an estimate
    # from one fanout directory, so the true loose count crossing gc.auto is a
    # proxy for "gc has work to do", not a prediction of when it fires.
    #
    # [warn], never [FAIL] - a full object store is not a broken install, and
    # doctor is diagnostic: it names the command, it never runs gc itself.
    loose = None
    co = git.out(["count-objects", "-v"], cwd=cwd)
    for ln in (co or "").split("\n"):
        if ln.startswith("count:"):
            try:
                loose = int(ln.split()[1])
            except (IndexError, ValueError):
                pass
    thr = 6700
    t = git.out(["config", "--get", "gc.auto"], cwd=cwd)
    if t:
        try:
            thr = int(t)
        except ValueError:
            pass
    if loose is None:
        pass                          # count-objects failed: say nothing, not a health claim
    elif thr > 0 and loose >= thr:
        say("warn", "loose objects",
            "%d in .git/objects (>= gc.auto %d) - moire's snapshot objects are "
            "refless and reclaimed by git housekeeping; run `git gc` to sweep now"
            % (loose, thr))
    elif thr > 0:
        say(True, "loose objects", "%d (gc.auto %d)" % (loose, thr))
    else:
        say(True, "loose objects", "%d (gc.auto disabled)" % loose)

    # Catch at setup time the state `verify` would otherwise only reveal per
    # invocation: the default checker reads Python, so on a repo with no
    # tracked .py files `moire verify` performs no semantic check at all.
    # [warn], never [FAIL] - `check` and textual `verify` remain fully usable,
    # matching the dependency-dirs precedent below. `git ls-files -- '*.py'` is
    # a suffix census matching nested paths, not language semantics: exactly
    # the knowledge builtin-ast already embodies, and no package-manager
    # knowledge is added anywhere.
    chk = git.out(["config", "--get", "moire.checker"], cwd=cwd)
    if chk:
        lk = git.out(["config", "--get-all", "moire.link"], cwd=cwd)
        say(True, "verify checker configured",
            chk + ((" (links: %s)" % ", ".join(lk.split("\n"))) if lk else ""))
    else:
        n_py = len([l for l in (git.out(["ls-files", "--", "*.py"], cwd=cwd) or "").split("\n")
                    if l.strip()])
        if n_py:
            say(True, "verify checker",
                "builtin-ast (default) applies - %d tracked .py files" % n_py)
        else:
            say("warn", "verify checker",
                "builtin-ast (default) reads only Python and this repo tracks no .py files - "
                "`moire verify` will perform no semantic check until one is set: "
                "git config moire.checker '<cmd>' (README: the --checker contract)")

    wts = list_worktrees(git, cwd)
    say(True, "worktrees discoverable", "%d found" % len(wts))

    # Observational, never a FAIL: a top-level directory that exists in the
    # MAIN worktree and is git-ignored there (node_modules, .venv, vendor,
    # target, ...) but is absent from a linked worktree usually means
    # dependencies were never installed in that worktree - a checker run
    # there will drown in unresolved imports. Zero package-manager semantics:
    # only "exists + ignored in main, missing in linked" is observed.
    if len(wts) > 1:
        main_wt = wts[0]["worktree"]  # `git worktree list` puts the main worktree first
        try:
            entries = sorted(os.listdir(main_wt))
        except OSError:
            entries = []
        candidates = [nm for nm in entries
                      if nm != ".git" and os.path.isdir(os.path.join(main_wt, nm))]
        ignored_dirs = []
        if candidates:
            # One `check-ignore --stdin` for all candidates, not one subprocess
            # per directory. -z on both sides sidesteps core.quotePath mangling.
            p = subprocess.Popen([git.path, "-C", main_wt, "check-ignore", "--stdin", "-z"],
                                 stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL)
            out_ig, _ = p.communicate(
                b"\0".join(nm.encode("utf-8") for nm in candidates) + b"\0")
            ignored_dirs = [x.decode("utf-8", "replace")
                            for x in out_ig.split(b"\0") if x]
        # One warn per linked worktree, however many directories are missing -
        # a typical ignore file (dist, build, coverage, ...) would otherwise
        # bury the node_modules line that actually matters.
        for w in wts[1:]:
            missing = [nm for nm in ignored_dirs
                       if not os.path.isdir(os.path.join(w["worktree"], nm))]
            if missing:
                shown = ", ".join(missing[:5])
                if len(missing) > 5:
                    shown += " +%d more" % (len(missing) - 5)
                say("warn", "dependency dirs missing in %s" % w["worktree"],
                    "%s (present and git-ignored in %s)" % (shown, main_wt))

    return 0 if healthy[0] else 1


CLIENT_HOOKS = """\
# Claude Code - add to .claude/settings.json (or ~/.claude/settings.json):
{
  "hooks": {
    "PostToolUse": [
      {"matcher": "Edit|Write|MultiEdit|Bash",
       "hooks": [{"type": "command", "command": "%(bin)s check"}]}
    ]
  }
}

# Codex CLI - .codex/hooks.json:
{"hooks": {"PostToolUse": [{"matcher": "*", "command": ["%(bin)s", "check"]}]}}

# Cursor - .cursor/hooks.json:
{"hooks": {"postToolUse": [{"command": "%(bin)s check"}]}}

# OpenCode - .opencode/plugins/moire.ts:
export default { "tool.execute.after": async () => {
  await Bun.$`%(bin)s check`; } }
"""


def cmd_install(git, argv):
    opts, _pos = _parse_argv("install", argv, bool_flags=("--print-client-hooks",))
    cwd = os.getcwd()
    if not _require_git(git):
        return 2
    cd = common_dir(git, cwd)
    if not cd:
        sys.stderr.write("moire: not inside a git worktree\n")
        return 2

    dest = installed_bin(cd)
    if opts["--print-client-hooks"]:
        sys.stdout.write(CLIENT_HOOKS % {"bin": dest})
        return 0

    try:
        os.makedirs(os.path.dirname(dest))
    except OSError:
        pass
    src = os.path.realpath(__file__)
    if os.path.realpath(dest) != src:
        shutil.copyfile(src, dest)
    os.chmod(dest, 0o755)
    sys.stdout.write("installed binary: %s\n" % dest)

    hooks_dir = os.path.join(cd, "hooks")
    try:
        os.makedirs(hooks_dir)
    except OSError:
        pass

    for h in HOOKS:
        path = os.path.join(hooks_dir, h)
        chained = path + ".moire-chained"
        if os.path.exists(path):
            body = open(path).read()
            if HOOK_MARKER in body:
                sys.stdout.write("hook already installed: %s\n" % path)
                continue
            # preserve the pre-existing hook and call it from ours
            shutil.move(path, chained)
            os.chmod(chained, 0o755)
        script = "#!/bin/sh\n%s\n" % HOOK_MARKER
        if os.path.exists(chained):
            script += '[ -x "$0.moire-chained" ] && "$0.moire-chained" "$@"\n'
        script += '"%s" check >/dev/null 2>&1 || true\n' % dest
        script += "# <<< moire hook <<<\n"
        with open(path, "w") as f:
            f.write(script)
        os.chmod(path, 0o755)
        sys.stdout.write("installed hook: %s%s\n" % (path, " (chained)" if os.path.exists(chained) else ""))

    hp = git.out(["config", "--get", "core.hooksPath"], cwd=cwd)
    if hp:
        sys.stdout.write("WARNING: core.hooksPath is set to %r - hooks in the common dir "
                         "will NOT fire. Run: git config --unset core.hooksPath\n" % hp)
    sys.stdout.write("\nClient hooks are NOT installed automatically. "
                     "Run `moire install --print-client-hooks` for the snippets.\n")
    return 0


# --------------------------------------------------------------- wire-client
#
# `wire-client` writes into a file that makes an AI coding client execute
# `moire check` on every tool use - that is security-relevant, so every write
# is: byte-exact-diffed before it happens, gated behind an explicit --apply,
# atomic (temp file + os.replace), and backed up when it overwrites something
# that already existed. Malformed JSON is never rewritten, only reported.
# Shapes below are exactly CLIENT_HOOKS above, never invented fresh.

CLIENT_SPECS = {
    "claude": {"hooks_key": "hooks", "event_key": "PostToolUse"},
    "codex": {"hooks_key": "hooks", "event_key": "PostToolUse"},
    "cursor": {"hooks_key": "hooks", "event_key": "postToolUse"},
}


def _moire_json_entry(client, dest):
    """-> the hook-array entry for `client`, in the exact shape CLIENT_HOOKS
    prints for `moire install --print-client-hooks`. Never invent a new one.
    """
    if client == "claude":
        return {"matcher": "Edit|Write|MultiEdit|Bash",
                "hooks": [{"type": "command", "command": "%s check" % dest}]}
    if client == "codex":
        return {"matcher": "*", "command": [dest, "check"]}
    if client == "cursor":
        return {"command": "%s check" % dest}
    raise ValueError("unknown client %r" % client)


def _find_hook_array_target(client, data):
    """-> (container_dict, key) where this client's hook array already lives,
    or should be created. Prefers a key that is ALREADY there - checking the
    flat top-level name before the canonical `hooks.<Event>` nesting - so an
    existing file's structure is extended, never relocated. Only when
    neither is present do we create the canonical nested location.
    """
    spec = CLIENT_SPECS[client]
    hkey, ekey = spec["hooks_key"], spec["event_key"]
    if ekey in data:
        return data, ekey
    hooks = data.get(hkey)
    if isinstance(hooks, dict) and ekey in hooks:
        return hooks, ekey
    hooks = data.setdefault(hkey, {})
    if not isinstance(hooks, dict):
        raise ValueError("%r is not an object in this file" % hkey)
    return hooks, ekey


def _plan_json_wire(client, data, dest):
    """Mutate `data` in place to add this clone's hook entry. -> True if a
    moire entry for `dest` was ALREADY present (data left untouched from the
    caller's perspective - nothing new was appended), False if `data` was
    just extended. A pre-existing non-list value at the target key is kept
    as the array's first element, never dropped.
    """
    container, key = _find_hook_array_target(client, data)
    val = container.get(key)
    if val is None:
        arr = []
        container[key] = arr
    elif isinstance(val, list):
        arr = val
    else:
        arr = [val]
        container[key] = arr
    for entry in arr:
        if dest in json.dumps(entry):
            return True
    arr.append(_moire_json_entry(client, dest))
    return False


def _wire_target_path(client, scope, top):
    home = os.path.expanduser("~")
    if client == "claude":
        return (os.path.join(home, ".claude", "settings.json") if scope == "user"
                else os.path.join(top, ".claude", "settings.local.json"))
    if client == "codex":
        return (os.path.join(home, ".codex", "hooks.json") if scope == "user"
                else os.path.join(top, ".codex", "hooks.json"))
    if client == "cursor":
        return (os.path.join(home, ".cursor", "hooks.json") if scope == "user"
                else os.path.join(top, ".cursor", "hooks.json"))
    if client == "opencode":
        return os.path.join(top, ".opencode", "plugins", "moire.ts")
    raise ValueError("unknown client %r" % client)


def _atomic_write_text(path, text):
    """Temp file in the SAME directory + os.replace - the write is atomic
    even if the process dies mid-write, so a reader (a client parsing this
    file to decide what to execute) never observes a half-written file.
    """
    d = os.path.dirname(path) or "."
    try:
        os.makedirs(d)
    except OSError:
        pass
    fd, tmp = tempfile.mkstemp(prefix=".moire-wire-", dir=d)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _opencode_plugin_content(dest):
    return ('export default { "tool.execute.after": async () => {\n'
            '  await Bun.$`%s check`; } }\n' % dest)


def _wire_opencode(path, dest, apply_):
    """opencode's hook is a TypeScript plugin, not JSON. There is no merge:
    create it if absent, and if it already exists leave it alone completely
    - moire never attempts to parse or rewrite TS.
    """
    content = _opencode_plugin_content(dest)
    if os.path.exists(path):
        sys.stdout.write(
            "%s already exists. opencode plugins are TypeScript, not JSON - "
            "moire never merges them; leaving it untouched. Add this snippet "
            "yourself if it is not already there:\n\n%s" % (path, content))
        return 0
    if not apply_:
        sys.stdout.write("Would create %s:\n\n%s\n" % (path, content))
        sys.stdout.write("Nothing written. Re-run with --apply to write this file.\n")
        return 0
    _atomic_write_text(path, content)
    sys.stdout.write("wrote: %s\n" % path)
    return 0


def _wire_json_client(client, path, dest, apply_):
    exists = os.path.exists(path)
    raw = ""
    if exists:
        try:
            with open(path, "r", encoding="utf-8") as f:
                raw = f.read()
        except OSError as ex:
            sys.stderr.write("moire: cannot read %s: %s\n" % (path, ex))
            return 1
        try:
            data = json.loads(raw) if raw.strip() else {}
        except json.JSONDecodeError as ex:
            # Never rewrite a file we could not parse.
            sys.stderr.write(
                "moire: %s is not valid JSON, aborting - no changes made: %s\n" % (path, ex))
            return 1
    else:
        data = {}

    try:
        already = _plan_json_wire(client, data, dest)
    except ValueError as ex:
        sys.stderr.write("moire: %s: %s\n" % (path, ex))
        return 1

    if already:
        sys.stdout.write("already wired: %s\n" % path)
        return 0

    new_text = json.dumps(data, indent=2) + "\n"

    if not apply_:
        diff = difflib.unified_diff(
            raw.splitlines(keepends=True),
            new_text.splitlines(keepends=True),
            fromfile=path if exists else "/dev/null",
            tofile=path)
        sys.stdout.writelines(diff)
        sys.stdout.write("\nNothing written. Re-run with --apply to write this file.\n")
        return 0

    backup = None
    if exists:
        backup = path + ".moire-backup"
        shutil.copyfile(path, backup)
    _atomic_write_text(path, new_text)
    sys.stdout.write("wrote: %s\n" % path)
    if backup:
        sys.stdout.write("backup: %s\n" % backup)
    return 0


def cmd_wire_client(git, argv):
    usage = ("moire: usage: moire wire-client <claude|codex|cursor|opencode> "
             "[--scope user|project] [--apply]\n")
    if not argv or argv[0] in ("-h", "--help"):
        sys.stdout.write(usage)
        return 0
    client = argv[0]
    if client not in ("claude", "codex", "cursor", "opencode"):
        sys.stderr.write("moire: unknown client %r\n%s" % (client, usage))
        return 2

    scope = "project"
    apply_ = False
    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--scope" and i + 1 < len(argv):
            scope = argv[i + 1]
            i += 2
            continue
        if a == "--apply":
            apply_ = True
            i += 1
            continue
        sys.stderr.write("moire: unknown argument %r\n%s" % (a, usage))
        return 2
    if scope not in ("user", "project"):
        sys.stderr.write("moire: --scope must be user or project\n" + usage)
        return 2
    if client == "opencode" and scope == "user":
        sys.stderr.write("moire: opencode has no user scope - it is project-only\n")
        return 2

    if not _require_git(git):
        return 2
    cwd = os.getcwd()
    top = git.out(["rev-parse", "--show-toplevel"], cwd=cwd)
    if not top:
        sys.stderr.write("moire: not inside a git worktree\n")
        return 2
    top = os.path.realpath(top)
    cd = common_dir(git, cwd)
    if not cd:
        sys.stderr.write("moire: could not resolve git common dir\n")
        return 2
    dest = installed_bin(cd)
    path = _wire_target_path(client, scope, top)

    if client == "opencode":
        return _wire_opencode(path, dest, apply_)
    return _wire_json_client(client, path, dest, apply_)


# ---------------------------------------------------------------- init-swarm
#
# Collapses the manual six-step procedure in the README's Install section
# (worktrees, install, client hooks, skill, doctor) into one command.
# HARD SCOPE LIMIT: this creates worktrees and wires the tool. It never
# decides what an agent works on, assigns tasks, partitions files, or writes
# a task description - work partitioning is explicitly out of scope for this
# project (see the README's account of what was tried and thrown away).

def _tree_differs(a, b):
    """True if two directory trees differ in file set or byte CONTENT - never
    mtime, which a fresh copy of the source tree always changes even when
    nothing else did (that would make every re-run of init-swarm think an
    untouched skill differs and back it up for no reason). filecmp.cmp with
    shallow=False forces a real content read regardless of os.stat.  Any
    read/stat error counts as "differs": never skip a backup on doubt.
    """
    try:
        a_rel = set(os.path.relpath(os.path.join(dp, f), a)
                    for dp, _dn, fn in os.walk(a) for f in fn)
        b_rel = set(os.path.relpath(os.path.join(dp, f), b)
                    for dp, _dn, fn in os.walk(b) for f in fn)
    except OSError:
        return True
    if a_rel != b_rel:
        return True
    for rel in a_rel:
        try:
            if not filecmp.cmp(os.path.join(a, rel), os.path.join(b, rel), shallow=False):
                return True
        except OSError:
            return True
    return False


def _parse_init_swarm_args(argv):
    agents = None
    prefix = "agent"
    skills_mode = "user"
    dry_run = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--agents" and i + 1 < len(argv):
            agents = argv[i + 1]
            i += 2
            continue
        if a == "--prefix" and i + 1 < len(argv):
            prefix = argv[i + 1]
            i += 2
            continue
        if a == "--skills" and i + 1 < len(argv):
            skills_mode = argv[i + 1]
            i += 2
            continue
        if a == "--dry-run":
            dry_run = True
            i += 1
            continue
        raise ValueError("unknown argument %r" % a)
    if agents is None:
        raise ValueError("--agents N is required")
    try:
        agents = int(agents)
    except ValueError:
        raise ValueError("--agents must be an integer")
    if agents < 1:
        raise ValueError("--agents must be >= 1")
    if skills_mode not in ("user", "project", "none"):
        raise ValueError("--skills must be one of user|project|none")
    if not prefix or any(c in prefix for c in "/\\ \t\n"):
        raise ValueError("--prefix must not contain whitespace or path separators")
    return agents, prefix, skills_mode, dry_run


def cmd_init_swarm(git, argv):
    usage = ("moire: usage: moire init-swarm --agents N [--prefix agent] "
             "[--skills user|project|none] [--dry-run]\n")
    try:
        n, prefix, skills_mode, dry_run = _parse_init_swarm_args(argv)
    except ValueError as ex:
        sys.stderr.write("moire: %s\n%s" % (ex, usage))
        return 2

    def step(msg):
        sys.stdout.write(msg + "\n")

    ok = True

    # 1. Preflight -------------------------------------------------------
    step("== preflight ==")
    if not _require_git(git):
        return 1
    cwd = os.getcwd()
    top = git.out(["rev-parse", "--show-toplevel"], cwd=cwd)
    if not top:
        sys.stderr.write("moire: not inside a git worktree\n")
        return 1
    top = os.path.realpath(top)
    step("  git %s at %s: ok" % (git.version_str, git.path))
    step("  inside a git worktree: %s" % top)
    head = git.out(["rev-parse", "HEAD"], cwd=top)
    if not head:
        sys.stderr.write("moire: repo has no commits yet - create an initial commit first\n")
        return 1
    step("  repo has a commit: ok (%s)" % head[:12])
    cd = common_dir(git, top)
    if not cd:
        sys.stderr.write("moire: could not resolve git common dir\n")
        return 1

    # 2. Worktrees ---------------------------------------------------------
    step("== worktrees ==")
    parent = os.path.dirname(top)
    repo_name = os.path.basename(top)
    created_any = False
    for i in range(1, n + 1):
        branch = "%s-%d" % (prefix, i)
        path = os.path.join(parent, "%s-%s-%d" % (repo_name, prefix, i))
        if os.path.isdir(path):
            step("  skip (exists): %s" % path)
            continue
        if dry_run:
            step("  [dry-run] would create worktree %s (branch %s)" % (path, branch))
            created_any = True        # the note below applies to what WOULD exist
            continue
        branch_exists = git.out(["rev-parse", "--verify", "--quiet",
                                 "refs/heads/%s" % branch], cwd=top) is not None
        args = ["worktree", "add"]
        args += [path, branch] if branch_exists else ["-b", branch, path]
        rc, out, err = git(args, cwd=top)
        if rc != 0:
            sys.stderr.write("  FAIL: worktree add %s: %s\n" % (path, (err or out).strip()))
            ok = False
            continue
        step("  created: %s (branch %s)" % (path, branch))
        created_any = True
    # Static and language-agnostic on purpose: no detection, no package-manager
    # knowledge. Auto-symlinking one shared dependency directory across N
    # worktrees would manufacture exactly the cross-worktree interference moire
    # exists to detect. Printed only when a worktree was actually created:
    # advice about fresh worktrees is noise when none exist.
    if created_any:
        step("  note: fresh worktrees contain only tracked files. Project-local dependency")
        step("        directories (node_modules, .venv, vendor, target) are not created.")
        step("        Install dependencies in each worktree separately - do not share one")
        step("        dependency directory across worktrees via symlink: concurrent agents")
        step("        would then be mutating each other's dependencies.")

    # 3. Install -- reuses cmd_install() verbatim, never duplicated --------
    step("== install ==")
    if dry_run:
        dest = installed_bin(cd)
        step("  [dry-run] would install binary to %s" % dest)
        for h in HOOKS:
            step("  [dry-run] would install hook %s" % os.path.join(cd, "hooks", h))
    else:
        old_cwd = os.getcwd()
        try:
            os.chdir(top)
            rc = cmd_install(git, [])
        finally:
            os.chdir(old_cwd)
        if rc != 0:
            ok = False

    # 4. Skills --------------------------------------------------------
    step("== skills ==")
    script_dir = os.path.dirname(os.path.realpath(__file__))
    skills_root = os.path.normpath(os.path.join(script_dir, "..", "skills"))
    # Every directory under skills/ that holds a SKILL.md, so a new skill is picked
    # up without touching this code.
    src_skills = []
    if os.path.isdir(skills_root):
        for name in sorted(os.listdir(skills_root)):
            d = os.path.join(skills_root, name)
            if os.path.isfile(os.path.join(d, "SKILL.md")):
                src_skills.append((name, d))
    if skills_mode == "none":
        step("  --skills none: skipping")
    elif not src_skills:
        # Installs from npm ship skills/; a bare checkout of just bin/moire may not.
        step("  no skills/ found next to %s: skipping" % script_dir)
    else:
        if skills_mode == "user":
            home = os.path.expanduser("~")
            roots = [os.path.join(home, ".claude", "skills"),
                     os.path.join(home, ".agents", "skills")]
        else:  # project
            roots = [os.path.join(top, ".claude", "skills")]
            sys.stdout.write(
                "  WARNING: --skills project writes into the working tree (%s) "
                "- add it to .gitignore.\n" % roots[0])
        for name, src in src_skills:
            for root in roots:
                d = os.path.join(root, name)
                if dry_run:
                    step("  [dry-run] would copy %s -> %s" % (src, d))
                    continue
                if os.path.isdir(d) and _tree_differs(src, d):
                    backup = d + ".moire-backup"
                    if os.path.isdir(backup):
                        shutil.rmtree(backup)
                    shutil.move(d, backup)
                    step("  backed up differing copy: %s -> %s" % (d, backup))
                shutil.copytree(src, d, dirs_exist_ok=True)
                step("  copied: %s" % d)

    # 5. Doctor --------------------------------------------------------
    step("== doctor ==")
    if dry_run:
        step("  [dry-run] would run doctor checks")
    else:
        old_cwd = os.getcwd()
        try:
            os.chdir(top)
            rc = cmd_doctor(git, [])
        finally:
            os.chdir(old_cwd)
        if rc != 0:
            ok = False

    # 6. Next steps ------------------------------------------------------
    step("== next steps ==")
    prog = sys.argv[0] if sys.argv else "moire"
    step("  Wire your AI client's hook (plan first, then --apply), e.g.:")
    step("    %s wire-client claude --scope user --apply" % prog)
    step("  (swap 'claude' for codex/cursor/opencode as needed)")

    return 0 if ok else 1


def _read_log_records(ld):
    """-> (records, checks): every record across every shard file in `ld`, and
    the shard (= check/verify invocation) count. Skips dotfiles (in-progress
    temp shards, still mid-rename) and any shard that fails to parse - a
    reader must never choke on a shard another process is still writing.
    Shared by the plain report and `--study`, which both start from exactly
    the same accumulated log; deriving `--study` from anything else would
    violate "do not add new state files or counters".
    """
    records, checks = [], 0
    if os.path.isdir(ld):
        for fn in sorted(os.listdir(ld)):
            if not fn.endswith(".json") or fn.startswith("."):
                continue
            try:
                with open(os.path.join(ld, fn)) as f:
                    arr = json.load(f)
            except Exception:
                continue
            checks += 1
            if isinstance(arr, list):
                records.extend(arr)
    return records, checks


# -------------------------------------------------------------------- report
#
# Everything below is derived by re-reading the same log shards `moire report`
# already reads - no new state file, no counter maintained incrementally by
# `check`/`verify`. That is deliberate: concurrent writers make
# read-modify-write racy (graft #10's own lesson, one shard per invocation,
# generalises to "don't maintain shared mutable summaries either").

def _pair_key(rec):
    s = (rec.get("self") or {}).get("worktree")
    p = (rec.get("peer") or {}).get("worktree")
    if not s or not p:
        return None
    return tuple(sorted((s, p)))


RECORD_VERSION = 2


def _pair_state_key(rec):
    """-> the observed CONTENT state of a worktree pair: a sorted (self_tree,
    peer_tree) pair of snapshot tree OIDs, or None when either is missing.

    This, not the record, is what a rate must be computed over. A hook that
    fires on every write re-observes an unchanged pair dozens of times; every
    one of those observations is a record, and counting records made a single
    collision seen four times read as "4 pairs, 4 breakages, rate 1.0". Tree
    OIDs are content-addressed, so two observations collapse into one
    pair-state exactly when nothing either side owns has changed - which is
    the definition of "the same situation", and the only denominator the
    project's kill criterion can be honestly stated over.

    What it is NOT: a task, a merge, a session, or a day. Two agents that
    edit, revert, and re-edit the same file produce three pair-states.
    """
    st = (rec.get("self") or {}).get("tree")
    pt = (rec.get("peer") or {}).get("tree")
    if not st or not pt:
        return None
    return tuple(sorted((st, pt)))


def _finding_kind(rec):
    """-> 'textual' | 'semantic' for a record that carries a finding_id.
    Textual: verdict == 'conflict' (check or verify, `conflict_paths` is
    what named the finding). Semantic: verify's clean-but-broken-merge case
    (`semantic.new_breakage` under a clean verdict). A conflict record may
    now ALSO carry `semantic.new_breakage` - the builtin checker runs under
    a textual conflict for breakage on files disjoint from it - and is still
    classified 'textual', because `_finding_tokens` keys the finding on
    `conflict_paths`; that extra dimension is surfaced separately as
    `semantic_findings_under_conflict` in `report`.
    """
    return "textual" if rec.get("verdict") == "conflict" else "semantic"


def _semantic_skipped(rec):
    """-> True when a verify record's semantic pass was skipped because the
    merge conflicted textually. Derived, not stored: check records carry no
    "semantic" key at all, verify records always do (None until computed), so
    the three-way test is exact on logs already collected."""
    return "semantic" in rec and rec["semantic"] is None and rec.get("verdict") == "conflict"


def _semantic_unperformed(rec):
    """-> True when a verify record's checker ran but could read nothing
    (builtin-ast on a tree with no .py files). Not a clean semantic pair and
    not a skipped one: the merge was textually evaluated, its semantics never
    checked. Excluded from semantic_rate's denominator - a vacuous pass must
    not drag the Phase 1 rate toward zero. Pre-fix records lack the key and
    default to performed."""
    sem = rec.get("semantic")
    return isinstance(sem, dict) and sem.get("performed", True) is False


def _semantic_under_conflict_finding(rec):
    """-> True for a verify record whose builtin checker ran UNDER a textual
    conflict and found breakage on files disjoint from it."""
    sem = rec.get("semantic")
    return (isinstance(sem, dict) and bool(sem.get("under_conflict"))
            and bool(sem.get("new_breakage")))


def _finding_lifecycle(records):
    """-> {finding_id: {...}} - one entry per distinct finding_id seen across
    every record, built purely by grouping/re-scanning; nothing here is
    accumulated across calls or persisted. Used by `report`'s findings
    section (first/last/times_seen/live/kind).
    """
    finding_records = {}
    pair_records = {}
    for r in records:
        pk = _pair_key(r)
        if pk:
            pair_records.setdefault(pk, []).append(r)
        fid = r.get("finding_id")
        if fid:
            finding_records.setdefault(fid, []).append(r)

    # The most recent record observed for each worktree pair, regardless of
    # which finding_id (or none) it carries - this is what answers "is a
    # given finding still live", by comparing its id against whatever the
    # pair's latest check actually saw.
    latest_by_pair = {}
    for pk, rs in pair_records.items():
        latest_by_pair[pk] = max(rs, key=lambda r: (r.get("ts") or "", r.get("check_id") or ""))

    meta = {}
    for fid, rs in finding_records.items():
        rs_sorted = sorted(rs, key=lambda r: (r.get("ts") or "", r.get("check_id") or ""))
        first_rec, last_rec = rs_sorted[0], rs_sorted[-1]
        latest_pair_rec = latest_by_pair.get(_pair_key(last_rec))
        live = bool(latest_pair_rec is not None and latest_pair_rec.get("finding_id") == fid)

        meta[fid] = {
            "finding_id": fid,
            "first_seen": first_rec.get("ts"),
            "last_seen": last_rec.get("ts"),
            "times_seen": len(rs),
            "live": live,
            "kind": _finding_kind(last_rec),
        }
    return meta


def cmd_report(git, argv):
    """Rates over distinct PAIR-STATES, not over observations.

    The distinction is the whole point of this command. Every rate below has
    as its denominator the number of distinct observed content-states of a
    worktree pair (see _pair_state_key), and every count of findings is a
    count of distinct finding_ids. The raw observation counts are still
    printed - one line, clearly labelled - because they are what the log
    literally contains and hiding them would make the derivation
    unauditable; but nothing is a rate over them.
    """
    if "--study" in argv:
        # A named refusal, not the generic "unknown argument" one: --study
        # used to be a real command surface (the suppression-arm study, now
        # deleted - see D1) and a caller who still types it deserves to be
        # told why, not just that the flag is unrecognised. Checked and
        # refused BEFORE _parse_argv/log access, same as every other refusal.
        _refuse("report", "unknown argument '--study' for report "
                "(removed in 0.11; see report's findings section)")
    opts, _pos = _parse_argv("report", argv, bool_flags=("--json",))
    as_json = opts["--json"]
    cwd = os.getcwd()
    cd = common_dir(git, cwd) if git.path else None
    if not cd:
        sys.stderr.write("moire: not inside a git worktree\n")
        return 2
    ld = log_dir(cd)
    all_records, checks = _read_log_records(ld)

    # Older records carry no pair-state that can be trusted the same way (the
    # finding_id they hold was computed path-only, and their rates were
    # per-observation), so they are counted and set aside rather than mixed
    # in. Retroactive derivation is the rule everywhere else in this tool -
    # `report` re-derives everything from the raw shards on every call - and
    # this is the one place it cannot: the shape changed under the records.
    records = [r for r in all_records if r.get("v") == RECORD_VERSION]
    pre_v2 = len(all_records) - len(records)

    # --- textual, per pair-state -----------------------------------------
    evaluated = {}
    for r in records:
        if r.get("verdict") not in ("clean", "conflict"):
            continue
        k = _pair_state_key(r)
        if k is None:
            continue
        evaluated[k] = evaluated.get(k, False) or (r["verdict"] == "conflict")
    pair_states = len(evaluated)
    conflicting_states = sum(1 for v in evaluated.values() if v)
    textual_rate = (float(conflicting_states) / pair_states) if pair_states else None

    # --- semantic, per pair-state ----------------------------------------
    # A verify record whose semantic pass actually ran carries a dict; one
    # pre-empted by a textual conflict is counted as skipped, not clean.
    # under_conflict records are excluded: they are not clean merges, and the
    # published kill criterion is about clean merges. A record whose checker
    # could read nothing (builtin-ast on a tree with no .py files) is
    # excluded too - it measured nothing, so counting it as a clean semantic
    # pair-state would bias the rate toward zero on exactly the repos where
    # nothing was checked. Both are counted separately, never discarded.
    performed_states = {}
    for r in records:
        sem = r.get("semantic")
        if not isinstance(sem, dict) or sem.get("under_conflict") or not sem.get("performed", True):
            continue
        k = _pair_state_key(r)
        if k is None:
            continue
        performed_states[k] = performed_states.get(k, False) or bool(sem.get("new_breakage"))
    semantic_states = len(performed_states)
    broken_states = sum(1 for v in performed_states.values() if v)
    semantic_rate = (float(broken_states) / semantic_states) if semantic_states else None

    # --- distinct findings ------------------------------------------------
    meta = _finding_lifecycle(records)
    findings = [meta[f] for f in
                sorted(meta, key=lambda f: (-meta[f]["times_seen"], f))][:20]
    findings = [{"finding_id": m["finding_id"], "kind": m["kind"],
                 "first_seen": m["first_seen"], "last_seen": m["last_seen"],
                 "times_seen": m["times_seen"], "live": m["live"]}
                for m in findings]
    distinct_textual = sum(1 for m in meta.values() if m["kind"] == "textual")
    distinct_semantic = sum(1 for m in meta.values() if m["kind"] == "semantic")

    # --- cleared vs outstanding -------------------------------------------
    # `live` (computed by _finding_lifecycle) already answers exactly this:
    # a finding is outstanding when it is still what the latest record for
    # its pair produces, cleared when a later record for that same pair
    # stopped producing it. Reusing `live` rather than re-deriving keeps this
    # in lockstep with the "findings (... live=yes/no)" section below - the
    # two can never disagree, because they read the same field.
    #
    # "Cleared" is deliberately not "resolved": the pair-state stopped
    # producing the finding for any reason - one side landed, rebased,
    # narrowed, or simply abandoned the work - and nothing here attributes
    # cause. It is the instrument for a future clearance-rate study, not a
    # claim that any agent did the right thing.
    distinct_cleared = sum(1 for m in meta.values() if not m["live"])
    distinct_outstanding = sum(1 for m in meta.values() if m["live"])

    # --- raw observations (transparency, never a denominator) -------------
    obs_pairs = [r for r in records if r.get("verdict") in ("clean", "conflict")]
    obs_conflicts = [r for r in obs_pairs if r["verdict"] == "conflict"]
    obs_semantic = [r for r in records
                    if isinstance(r.get("semantic"), dict)
                    and not r["semantic"].get("under_conflict")
                    and r["semantic"].get("performed", True)]
    obs_breakage = [r for r in obs_semantic if r["semantic"].get("new_breakage")]
    errors = [r for r in records if r.get("verdict") == "error"]
    peers = set(r["peer"]["worktree"] for r in records if r.get("peer"))

    paths = {}
    for r in obs_conflicts:
        for p in r.get("conflict_paths", []):
            paths[p] = paths.get(p, 0) + 1
    top_paths = sorted(paths.items(), key=lambda kv: (-kv[1], kv[0]))[:10]

    under_conflict_findings = [r for r in records if _semantic_under_conflict_finding(r)]
    skipped_semantic = sum(1 for r in records if _semantic_skipped(r))
    unperformed_semantic = sum(1 for r in records if _semantic_unperformed(r))

    if as_json:
        sys.stdout.write(json.dumps({
            "checks": checks,
            "pre_v2_records_ignored": pre_v2,
            "pair_states_evaluated": pair_states,
            "conflicting_pair_states": conflicting_states,
            "textual_rate": textual_rate,
            "semantic_pair_states_performed": semantic_states,
            "broken_pair_states": broken_states,
            "semantic_rate": semantic_rate,
            "distinct_findings": {"textual": distinct_textual,
                                  "semantic": distinct_semantic},
            # Additive alongside distinct_findings, not nested in it: these
            # partition by STATUS (still producing vs not), a different axis
            # than kind's textual/semantic. See the docstring above meta's
            # computation for what "cleared" does and does not claim.
            "findings_cleared": distinct_cleared,
            "findings_outstanding": distinct_outstanding,
            "findings": findings,
            "top_paths": top_paths,
            "semantic_findings_under_conflict": len(under_conflict_findings),
            "skipped_semantic_checks": skipped_semantic,
            "unperformed_semantic_checks": unperformed_semantic,
            "distinct_peers": len(peers),
            "errors": len(errors),
            # Kept for transparency and for anyone reconciling these numbers
            # against the shards by hand. Never a denominator - see the
            # docstring.
            "observations": {
                "pair_records": len(obs_pairs),
                "conflict_records": len(obs_conflicts),
                "semantic_records": len(obs_semantic),
                "breakage_records": len(obs_breakage),
            },
        }, indent=2) + "\n")
        return 0

    sys.stdout.write("checks run                        : %d\n" % checks)
    sys.stdout.write("pre-v2 records ignored            : %d%s\n" %
                     (pre_v2, "  (delete .git/moire/log to reset)" if pre_v2 else ""))
    sys.stdout.write("pair-states evaluated             : %d    "
                     "(distinct (self_tree, peer_tree) observations)\n" % pair_states)
    sys.stdout.write("conflicting pair-states           : %d\n" % conflicting_states)
    if textual_rate is None:
        sys.stdout.write("textual rate (per pair-state)     : n/a (no pair-states evaluated)\n")
    else:
        sys.stdout.write("textual rate (per pair-state)     : %.1f%%\n" % (100.0 * textual_rate))
    sys.stdout.write("semantic pair-states (performed)  : %d\n" % semantic_states)
    sys.stdout.write("broken pair-states                : %d\n" % broken_states)
    if semantic_rate is None:
        sys.stdout.write("semantic rate (clean pair-states that break) : "
                         "n/a (no performed semantic pair-states)\n")
    else:
        sys.stdout.write("semantic rate (clean pair-states that break) : %.1f%%   [n=%d]\n"
                         % (100.0 * semantic_rate, semantic_states))
    sys.stdout.write("distinct findings                 : %d textual, %d semantic\n"
                     % (distinct_textual, distinct_semantic))
    sys.stdout.write("%-34s: %d cleared, %d outstanding   (cleared = the pair-state stopped\n"
                     "                                    producing it; cause is not implied)\n"
                     % ("findings cleared / outstanding", distinct_cleared, distinct_outstanding))
    sys.stdout.write("raw observations                  : %d pair records, %d conflicts, "
                     "%d semantic, %d breakage\n"
                     % (len(obs_pairs), len(obs_conflicts), len(obs_semantic), len(obs_breakage)))
    sys.stdout.write("distinct peers seen               : %d\n" % len(peers))
    sys.stdout.write("errors                            : %d\n" % len(errors))
    sys.stdout.write("skipped semantic checks           : %d\n" % skipped_semantic)
    sys.stdout.write("semantic checks not performed     : %d\n" % unperformed_semantic)
    sys.stdout.write("semantic findings under conflict  : %d\n" % len(under_conflict_findings))
    if top_paths:
        sys.stdout.write("\ntop contested paths:\n")
        for p, n in top_paths:
            sys.stdout.write("  %4d  %s\n" % (n, p))
    if findings:
        sys.stdout.write("\nfindings (top 20 by times seen):\n")
        for m in findings:
            sys.stdout.write("  %s  %-8s  seen=%-4d first=%s  last=%s  live=%s\n" % (
                m["finding_id"], m["kind"], m["times_seen"],
                m["first_seen"], m["last_seen"], "yes" if m["live"] else "no"))
    return 0


# ------------------------------------------------------------ pending / compose
#
# The resolution layer's two query surfaces. Both read the log the same way
# `report` does (_read_log_records, RECORD_VERSION-only) and write NOTHING -
# no snapshot, no cache touch, no log shard, no read of any peer worktree.
# That is not an optimisation; it is the whole point: an agent must be able
# to run `pending` at session start and before declaring work done, and
# `compose` every time it wants to hand a finding to another agent, with
# zero cost and zero risk of racing `check`/`verify`'s own shard writes.
#
# Neither command ever executes a rebase, opens a socket, or otherwise
# reaches beyond the log - moire composes a message; it does not send one.
# See the module docstring's "warn-only" note and research/design-v13 for
# why sending stays out of scope for good (discovery, identity, retry, and a
# config surface all follow from it, and each one is a vendor coupling this
# tool does not take on).

def _parse_ts(ts):
    """-> a tz-aware UTC datetime for a check/verify `ts` field, or None."""
    if not ts:
        return None
    try:
        return datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def _age_seconds(ts):
    """-> whole seconds since `ts`, never negative (a clock skew that makes
    `ts` look future reads as 0, not a confusing negative age), or None."""
    t = _parse_ts(ts)
    if t is None:
        return None
    return max(0, int((datetime.now(timezone.utc) - t).total_seconds()))


def _fmt_age_secs(secs):
    if secs < 60:
        return "%ds" % secs
    mins, secs = divmod(secs, 60)
    if mins < 60:
        return "%dm" % mins
    hours, mins = divmod(mins, 60)
    if hours < 24:
        return "%dh%dm" % (hours, mins)
    days, hours = divmod(hours, 24)
    return "%dd%dh" % (days, hours)


def _fmt_age(ts):
    secs = _age_seconds(ts)
    return None if secs is None else _fmt_age_secs(secs)


def _finding_facts(rec):
    """-> (kind, items, meaning) for a record carrying a finding_id.

    kind: 'textual' or 'semantic', from `_finding_kind` - the same predicate
    `report` already uses, so pending/compose and report can never disagree
    about what a given record IS.
    items: contested paths (textual) or breakage triples (semantic), each
    already display-ready (a JSON round-tripped tuple restored from a list).
    meaning: the one-line consequence, in the exact words SKILL.md already
    teaches an agent to expect - reused, not reinvented, so a composed
    message and the skill read as one voice.
    """
    kind = _finding_kind(rec)
    if kind == "textual":
        items = list(rec.get("conflict_paths") or [])
        meaning = "git will stop with conflict markers here"
    else:
        sem = rec.get("semantic") or {}
        items = [tuple(x) if isinstance(x, list) else x
                for x in (sem.get("new_breakage") or [])]
        meaning = "git merges this cleanly; the result is broken"
    return kind, items, meaning


def cmd_pending(git, argv):
    """What findings exist right now between me and each peer, per the log
    alone - what an agent consults at session start and before declaring
    work done. Groups THIS worktree's own logged records by peer, takes the
    latest one per peer, and shows it only if that latest record still
    carries a finding_id: a finding that appeared in an earlier record but
    is absent from the latest one for the same pair is cleared, and cleared
    findings are not shown here (only counted, by `report`).

    Read-only by construction: nothing below ever opens a log file for
    writing, touches the snapshot cache, or reads a peer worktree's files -
    only records THIS worktree already wrote to the shared log on some
    earlier `check`/`verify` are consulted. "Right now" is therefore a claim
    about the log, not the worktrees, which is why every line carries a
    record age and the output always ends by saying so.
    """
    opts, _pos = _parse_argv("pending", argv, bool_flags=("--json",))
    as_json = opts["--json"]

    cwd = os.getcwd()
    cd = common_dir(git, cwd) if git.path else None
    if not cd:
        sys.stderr.write("moire: not inside a git worktree\n")
        return 2
    top = git.out(["rev-parse", "--show-toplevel"], cwd=cwd)
    if not top:
        sys.stderr.write("moire: not inside a git worktree\n")
        return 2
    top = os.path.realpath(top)

    ld = log_dir(cd)
    all_records, _checks = _read_log_records(ld)
    records = [r for r in all_records if r.get("v") == RECORD_VERSION]
    pre_v2 = len(all_records) - len(records)

    # Only records THIS worktree logged as "self" - pending answers "what do
    # I know about each peer", not "what does the shared log know about any
    # pair regardless of who ran the check", which is `report`'s question
    # (it uses the unordered _pair_key instead, on purpose - see there).
    by_peer = {}
    for r in records:
        if (r.get("self") or {}).get("worktree") != top:
            continue
        p = (r.get("peer") or {}).get("worktree")
        if not p:
            continue
        by_peer.setdefault(p, []).append(r)

    outstanding = []
    for _peer_wt, rs in by_peer.items():
        latest = max(rs, key=lambda r: (r.get("ts") or "", r.get("check_id") or ""))
        if latest.get("finding_id"):
            outstanding.append(latest)
    outstanding.sort(key=lambda r: ((r.get("peer") or {}).get("worktree") or "",
                                    r.get("ts") or ""))

    if as_json:
        out = []
        for r in outstanding:
            kind, items, meaning = _finding_facts(r)
            out.append({
                "finding_id": r.get("finding_id"), "kind": kind,
                "self": r.get("self"), "peer": r.get("peer"),
                "verdict": r.get("verdict"), "items": _sorted_findings(items),
                "meaning": meaning, "arbiter": r.get("arbiter"),
                "ts": r.get("ts"), "age_seconds": _age_seconds(r.get("ts")),
            })
        sys.stdout.write(json.dumps({
            "pre_v2_records_ignored": pre_v2,
            "outstanding": out,
        }, indent=2) + "\n")
        return 0

    sys.stdout.write("pre-v2 records ignored            : %d%s\n" %
                     (pre_v2, "  (delete .git/moire/log to reset)" if pre_v2 else ""))

    if not outstanding:
        sys.stdout.write("moire: no outstanding findings\n")
        sys.stdout.write("(from the log; re-run 'moire check' for a live answer)\n")
        return 0

    for r in outstanding:
        kind, items, meaning = _finding_facts(r)
        peer_wt = r["peer"]["worktree"]
        branch = r["peer"].get("branch") or "detached"
        age = _fmt_age(r.get("ts")) or "unknown"
        label = "CONFLICT" if kind == "textual" else "BROKEN"
        sys.stdout.write("%s with %s (%s) [finding %s] kind=%s age=%s\n" %
                         (label, peer_wt, branch, r.get("finding_id"), kind, age))
        for it in _sorted_findings(items):
            sys.stdout.write("    %s\n" % (tuple(it) if isinstance(it, list) else it,))
        arb = r.get("arbiter")
        if arb:
            sys.stdout.write("  arbiter: %s yields (%s)\n" % (arb["yield"], arb["reason"]))

    ages = [a for a in (_age_seconds(r.get("ts")) for r in outstanding) if a is not None]
    if ages:
        sys.stdout.write("(from the log; oldest of the above is %s old; "
                         "re-run 'moire check' for a live answer)\n" % _fmt_age_secs(max(ages)))
    else:
        sys.stdout.write("(from the log; re-run 'moire check' for a live answer)\n")
    return 0


COMPOSE_ACTIONS = ("rebase", "narrow", "retarget", "wait", "proceed")

# Each value is the SENDER's own self-binding statement of what they chose -
# never a demand on the receiver, who decides only after re-verifying
# locally (see cmd_compose's VERIFY section and the skill's resolution
# protocol). "sender" here names the agent composing the message, not
# moire: moire composes the text below and performs none of these actions.
ACTION_STATEMENTS = {
    "rebase": "sender is rebasing their own work onto the peer's",
    "narrow": "sender is narrowing their own change to drop the contested part",
    "retarget": "sender is retargeting their own work onto what already exists in the peer's",
    "wait": "sender is waiting for the peer to land before continuing here",
    "proceed": "sender is proceeding as-is",
}


def cmd_compose(git, argv):
    """Render one finding, looked up by id in the log, as a message shaped
    for pasting into another agent's session via whatever transport the
    CALLER's harness provides (Claude Code cross-session messaging, agent
    teams, A2A, ...). moire never transmits it: no discovery, no identity,
    no retry, no config surface - composing the text is the boundary, and
    the agent on the other end of that call is the one who moves it.

    Read-only, same as `pending`: no snapshot, no log write. The staleness
    safeguard is the protocol itself, not this command - the receiver
    re-verifies locally with their own `moire check`/`moire verify`, so a
    stale compose costs a re-check, never a wrong action taken on faith.
    """
    opts, pos = _parse_argv("compose", argv, bool_flags=("--json",),
                            value_flags=("--action",), positional=(1, 1))
    as_json = opts["--json"]
    action = opts["--action"]
    if action is not None and action not in COMPOSE_ACTIONS:
        _refuse("compose", "--action must be one of %s, got %r" %
               ("|".join(COMPOSE_ACTIONS), action))
    fid = pos[0]

    cwd = os.getcwd()
    cd = common_dir(git, cwd) if git.path else None
    if not cd:
        sys.stderr.write("moire: not inside a git worktree\n")
        return 2

    ld = log_dir(cd)
    all_records, _checks = _read_log_records(ld)
    matches = [r for r in all_records
              if r.get("v") == RECORD_VERSION and r.get("finding_id") == fid]
    if not matches:
        # Refused before any write - same discipline as every other command
        # here, and there IS nothing this command ever writes. `moire
        # replay` computes a finding_id (per the same algorithm) but never
        # touches the log at all - stateless by construction - so its ids
        # can never be looked up here. That is worth saying explicitly: a
        # caller who copied an id out of a `replay` run needs to know why it
        # is refused, not just that it is unknown.
        _refuse("compose",
               "no finding %r in the log. 'moire replay' writes no log, so a "
               "finding it reports can never be composed here - only "
               "findings from 'moire check'/'moire verify' are. A finding "
               "also stops appearing once its pair-state clears - run "
               "'moire pending' to see what is outstanding now." % fid)

    rec = max(matches, key=lambda r: (r.get("ts") or "", r.get("check_id") or ""))
    kind, items, meaning = _finding_facts(rec)
    items = _sorted_findings(items)
    self_ = rec.get("self") or {}
    peer = rec.get("peer") or {}
    arb = rec.get("arbiter")
    age = _fmt_age(rec.get("ts"))
    verify_cmd = "moire check" if kind == "textual" else "moire verify"
    merged_tree = (rec.get("semantic") or {}).get("merged_tree") if kind == "semantic" else None

    if as_json:
        sys.stdout.write(json.dumps({
            "finding_id": fid, "kind": kind,
            "from": {"worktree": self_.get("worktree"), "branch": self_.get("branch"),
                     "head": self_.get("head"), "ts": rec.get("ts"),
                     "age_seconds": _age_seconds(rec.get("ts"))},
            "peer": {"worktree": peer.get("worktree"), "branch": peer.get("branch")},
            "fact": {"verdict": rec.get("verdict"), "items": items,
                    "merged_tree": merged_tree, "meaning": meaning},
            "arbiter": arb,
            "sender_action": action,
            "verify_command": verify_cmd,
        }, indent=2) + "\n")
        return 0

    lines = []
    lines.append("moire finding %s" % fid)
    lines.append("(computable identically from your side - derived only from the two "
                 "worktree paths and the contested paths/breakage, never from anything "
                 "either of us declares)")
    lines.append("")
    lines.append("FROM")
    lines.append("  worktree : %s" % self_.get("worktree"))
    lines.append("  branch   : %s" % (self_.get("branch") or "detached"))
    lines.append("  HEAD     : %s" % (self_.get("head") or "unknown"))
    lines.append("  age      : %s" % (age or "unknown"))
    lines.append("")
    lines.append("THE FACT")
    lines.append("  %s" % ("CONFLICT" if kind == "textual" else "BROKEN"))
    lines.append("  verdict: %s" % rec.get("verdict"))
    if kind == "textual":
        lines.append("  contested path(s): %d" % len(items))
    else:
        lines.append("  breakage(s): %d%s" % (len(items),
                     (" (merged tree %s)" % merged_tree) if merged_tree else ""))
    for it in items:
        lines.append("    %s" % (tuple(it) if isinstance(it, list) else it,))
    lines.append("  meaning: %s" % meaning)
    lines.append("")
    if arb:
        lines.append("ARBITER")
        lines.append("  %s yields (%s)" % (arb["yield"], arb["reason"]))
        lines.append("  computed from facts observable to both of us; your moire will "
                     "say the same")
        lines.append("")
    lines.append("SENDER'S ACTION")
    lines.append("  %s" % (ACTION_STATEMENTS[action] if action else
                           "sender has not chosen an action yet"))
    lines.append("")
    lines.append("VERIFY")
    lines.append("  run `%s` in your own worktree - the same finding id (%s) confirms it"
                 % (verify_cmd, fid))
    sys.stdout.write("\n".join(lines) + "\n")
    return 0


USAGE = """\
moire - observed-diff conflict detection between concurrent git worktrees

  moire check [--json] [--peers a,b]   would my worktree conflict with each peer, right now?
  moire verify [--json] [--peers a,b] [--checker <cmd>] [--link <name>]...
                                    exact semantic check on the merge-tree already produced:
                                    would landing together break something, even textually clean?
                                    --link symlinks a named untracked directory (e.g.
                                    node_modules) from each worktree into its materialised
                                    tree so external checkers can resolve dependencies
                                    without either flag, reads the git config keys below
  moire replay <rev-a> <rev-b> [--checker <cmd>] [--link <name>]... [--json]
                                    the same mechanism on two COMMITS instead of two live
                                    worktrees: the measurement instrument. Stateless - no
                                    log, no cache, no snapshot, no worktree - and it works
                                    in a bare clone, which is how a corpus is replayed.
  moire doctor                         verify git version, hooks, install, state dir
  moire install [--print-client-hooks] install git hooks into $GIT_COMMON_DIR/hooks/
  moire init-swarm --agents N [--prefix agent] [--skills user|project|none] [--dry-run]
                                    create N sibling worktrees, install the binary/hooks,
                                    copy the agent skill, and run doctor - one command in
                                    place of the manual Install procedure. Never assigns
                                    tasks or partitions work - that is out of scope.
  moire wire-client <claude|codex|cursor|opencode> [--scope user|project] [--apply]
                                    plan (default) or write (--apply) the client hook that
                                    runs `moire check` after every tool use. Always diffs
                                    before writing, writes atomically, keeps a backup.
  moire report [--json]                rates over distinct pair-states, distinct findings
                                    (cleared vs still outstanding), and contested paths,
                                    from the log
  moire pending [--json]               what findings exist right now between me and each
                                    peer, from the log only - never writes, never reads a
                                    peer worktree; cleared findings are not shown (see
                                    'moire report' for cleared/outstanding counts)
  moire compose <finding-id> [--action rebase|narrow|retarget|wait|proceed] [--json]
                                    render one finding as a message shaped for another
                                    agent's session - read-only; moire composes the text,
                                    the calling agent's own transport moves it

Env vars:
  MOIRE_AGENT_ID       string, default unset - a provenance label recorded on your own
                    check/verify records; never read by any predicate

Git config keys (read by `verify`; `.git/config` is never cloned, so a checkout
cannot carry a command, and one setting covers every worktree of the repo):
  moire.checker        string, default unset - the checker command, as `--checker`.
                    Precedence: --checker flag > moire.checker > builtin-ast.
                       git config moire.checker '<cmd>'
  moire.link           string, repeatable - a directory to link, as `--link`. Links are
                    the union of flag occurrences and config entries.
                       git config --add moire.link <name>

Warn-only by design: `check` and `verify` never exit nonzero because of a
finding; they refuse with 2 on an unusable environment or a bad argument,
before writing any log. An unknown flag, or a value flag with nothing after
it, is a bad argument: moire refuses rather than silently ignoring it.
Requires git >= 2.38.
"""


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        sys.stdout.write(USAGE)
        return 0
    gitpath, ver = find_git()
    git = Git(gitpath, ver)
    cmd = argv[1]
    rest = argv[2:]
    if cmd == "check":
        return cmd_check(git, rest)
    if cmd == "verify":
        return cmd_verify(git, rest)
    if cmd == "replay":
        return cmd_replay(git, rest)
    if cmd == "doctor":
        return cmd_doctor(git, rest)
    if cmd == "install":
        return cmd_install(git, rest)
    if cmd == "init-swarm":
        return cmd_init_swarm(git, rest)
    if cmd == "wire-client":
        return cmd_wire_client(git, rest)
    if cmd == "report":
        return cmd_report(git, rest)
    if cmd == "pending":
        return cmd_pending(git, rest)
    if cmd == "compose":
        return cmd_compose(git, rest)
    sys.stderr.write("moire: unknown command %r\n\n%s" % (cmd, USAGE))
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
